            sh:name "Aldaera" ;
            sh:order 4 ;
            sh:path ms:variant ],
        [ skos:example "'Andaluz', 'Rioplatense', 'Valenciano'" ;
            sh:datatype rdf:langString ;
            sh:description "Edozein hizkuntza-aldaera edo dialektoren testu libreko izena, BCP47 azpietiketa erregistraturik ez dutenak barne (adib., andaluziera, rioplatensea, kanariarra)." ;
