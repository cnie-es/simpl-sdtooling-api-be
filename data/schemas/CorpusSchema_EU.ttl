@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix bcp47: <http://w3id.org/meta-share/bcp47/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix continent: <http://publications.europa.eu/resource/authority/continent/> .
@prefix country: <http://publications.europa.eu/resource/authority/country/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix edval: <http://w3id.org/gaia-x/edval#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix gax-validation: <http://w3id.org/gaia-x/validation#> .
@prefix ms: <http://w3id.org/meta-share/meta-share/> .
@prefix omtd: <http://w3id.org/meta-share/omtd-share/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix simpl: <http://w3id.org/gaia-x/simpl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gax-validation:CorpusOfferingShape a sh:NodeShape ;
    sh:property [ skos:example "'(ms:Corpus motako objektu bat title, description, lrType, mediaType, lingualityType, language, etab.)'" ;
            sh:description "LanguageDCAT-AP-ren Corpus profilarekin bat datozen corpusaren metadatuak, Europako Hizkuntza Datuen Espazioarekin elkarreragiteko. Izenburua, deskribapena, hizkuntza-baliabide mota, euskarri mota, hizkuntza-kopurua, hizkuntza-metadatuak, EBDO betetzeko propietateak eta banaketa-informazioa biltzen ditu." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Corpus aktiboa" ;
            sh:node gax-validation:CorpusShape ;
            sh:order 1 ;
            sh:path edval:corpusAsset ],
        [ skos:example "'true', 'false'" ;
            sh:datatype xsd:boolean ;
            sh:description "Hizkuntza-baliabidearen eskaintza hau sarbide publikokoa den (true) edo baimendutako alderdiei soilik mugatua dagoen (false) adierazten du." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Eskaintza publikoa" ;
            sh:order 2 ;
            sh:path edval:isPublicOffering ],
        [ skos:example "'(a structure object of type DataProperties'" ;
            sh:description "Zerbitzuaren oinarrizko sailkapena, hornikuntza motaren eta zerbitzu-ereduaren arabera." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Datuen propietateak" ;
            sh:node gax-validation:DataPropertiesShape ;
            sh:order 3 ;
            sh:path simpl:dataProperties ],
        [ skos:example "'(a structure object of type GeneralServiceProperties'" ;
            sh:description "Zerbitzuaren oinarrizko sailkapena, hornikuntza motaren eta zerbitzu-ereduaren arabera." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Zerbitzuaren propietate orokorrak" ;
            sh:node gax-validation:GeneralServicePropertiesShape ;
            sh:order 4 ;
            sh:path simpl:generalServiceProperties ],
        [ skos:example "'(a structure object of type AssetProperties'" ;
            sh:description "Zerbitzuaren oinarrizko sailkapena, hornikuntza motaren eta zerbitzu-ereduaren arabera." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Aktiboaren propietateak" ;
            sh:node gax-validation:AssetPropertiesShape ;
            sh:order 5 ;
            sh:path simpl:assetProperties ],
        [ skos:example "'(a structure object of type ProviderInformation'" ;
            sh:description "Zerbitzuaren oinarrizko sailkapena, hornikuntza motaren eta zerbitzu-ereduaren arabera." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Hornitzailearen informazioa" ;
            sh:node gax-validation:ProviderInformationShape ;
            sh:order 6 ;
            sh:path simpl:providerInformation ],
        [ skos:example "'(a structure object of type OfferingPrice'" ;
            sh:description "Zerbitzuaren oinarrizko sailkapena, hornikuntza motaren eta zerbitzu-ereduaren arabera." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Eskaintzaren prezioa" ;
            sh:node gax-validation:OfferingPriceShape ;
            sh:order 7 ;
            sh:path simpl:offeringPrice ],
        [ skos:example "'(a structure object of type ServicePolicy'" ;
            sh:description "Zerbitzuaren oinarrizko sailkapena, hornikuntza motaren eta zerbitzu-ereduaren arabera." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Zerbitzuaren politika" ;
            sh:node gax-validation:ServicePolicyShape ;
            sh:order 8 ;
            sh:path simpl:servicePolicy ],
        [ skos:example "'(a structure object of type ContractTemplate'" ;
            sh:description "Zerbitzuaren oinarrizko sailkapena, hornikuntza motaren eta zerbitzu-ereduaren arabera." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Kontratu-txantiloia" ;
            sh:node gax-validation:ContractTemplateShape ;
            sh:order 9 ;
            sh:path simpl:contractTemplate ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'(a structure object of type EdcRegistration'" ;
            sh:description "Zerbitzuaren oinarrizko sailkapena, hornikuntza motaren eta zerbitzu-ereduaren arabera." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "EDC erregistroa" ;
            sh:node gax-validation:EdcRegistrationShape ;
            sh:order 10 ;
            sh:path simpl:edcRegistration ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'(a structure object of type EdcConnector'" ;
            sh:description "Zerbitzuaren oinarrizko sailkapena, hornikuntza motaren eta zerbitzu-ereduaren arabera." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "EDC konektorea" ;
            sh:node gax-validation:EdcConnectorShape ;
            sh:order 11 ;
            sh:path simpl:edcConnector ] ;
    sh:targetClass edval:CorpusOffering .

gax-validation:AssetPropertiesShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "requiredOnFrontendOnly" ) ;
            skos:example "'{ 'Json' : 'Object' }'" ;
            sh:datatype xsd:string ;
            sh:description "Hornitzailearen datu-helbidea." ;
            sh:maxCount 1 ;
            sh:name "Hornitzailearen datu-helbidea" ;
            sh:order 1 ;
            sh:path simpl:providerDataAddress ] ;
    sh:targetClass simpl:AssetProperties .

gax-validation:ContractTemplateShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'Contract Template 1', 'Contract Template 2'" ;
            sh:datatype xsd:string ;
            sh:description "Kontratu-txantiloiaren dokumentua adierazten du." ;
            sh:in ( "Contract Template 1" "Contract Template 2" "Contract Template 3" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Kontratu-txantiloiaren dokumentua" ;
            sh:order 1 ;
            sh:path simpl:contractTemplateDocument ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'Free text'" ;
            sh:datatype xsd:string ;
            sh:description "Hash balioa adierazten du." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Kontratu-txantiloiaren hash balioa" ;
            sh:order 2 ;
            sh:path simpl:contractTemplateHashValue ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'Free text'" ;
            sh:datatype xsd:string ;
            sh:description "Hash algoritmoa adierazten du." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Kontratu-txantiloiaren hash algoritmoa" ;
            sh:order 3 ;
            sh:path simpl:contractTemplateHashAlg ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'URL'" ;
            sh:datatype xsd:string ;
            sh:description "URLa." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Kontratu-txantiloiaren URLa" ;
            sh:order 4 ;
            sh:path simpl:contractTemplateURL ] ;
    sh:targetClass simpl:ContractTemplate .

gax-validation:CorpusDistributionGroup a sh:PropertyGroup ;
    rdfs:label "Banaketa" ;
    sh:order 5 .

gax-validation:CorpusDocumentationGroup a sh:PropertyGroup ;
    rdfs:label "Dokumentazioa" ;
    sh:order 13 .

gax-validation:CorpusIntellectualPropertyRightsGroup a sh:PropertyGroup ;
    rdfs:label "Jabetza intelektualaren eskubideak" ;
    sh:order 9 .

gax-validation:CorpusLanguageGroup a sh:PropertyGroup ;
    rdfs:label "Hizkuntza" ;
    sh:order 3 .

gax-validation:CorpusLicenseGroup a sh:PropertyGroup ;
    rdfs:label "Lizentzia" ;
    sh:order 7 .

gax-validation:CorpusPivotLanguageGroup a sh:PropertyGroup ;
    rdfs:label "Hizkuntza pibotea" ;
    sh:order 12 .

gax-validation:CorpusPublisherGroup a sh:PropertyGroup ;
    rdfs:label "Argitaletxea" ;
    sh:order 8 .

gax-validation:CorpusShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'ms:corpus1'" ;
            sh:description "Aktibo hau corpus gisa identifikatzen duen hizkuntza-baliabide motaren IRIa (ms:LRTypeTaxonomy-tik)." ;
            sh:group gax-validation:CorpusBasicInformationGroup ;
            sh:in ( ms:corpus1 ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Hizkuntza-baliabide mota" ;
            sh:order 1 ;
            sh:path ms:lrType ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'Corpus Legal Español'" ;
            sh:datatype rdf:langString ;
            sh:description "Hizkuntza-baliabidearen izenburu irakurgarria" ;
            sh:group gax-validation:CorpusBasicInformationGroup ;
            sh:minCount 1 ;
            sh:name "Izenburua" ;
            sh:order 2 ;
            sh:path dct:title ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'Un corpus de documentos legales de tribunales españoles anotado con entidades nombradas'" ;
            sh:datatype rdf:langString ;
            sh:description "Baliabidearen edukiaren eta helburuaren deskribapen irakurgarria." ;
            sh:group gax-validation:CorpusBasicInformationGroup ;
            sh:minCount 1 ;
            sh:name "Deskribapena" ;
            sh:order 3 ;
            sh:path dct:description ],
        [ skos:example "'1.0', '2.1.3'" ;
            sh:datatype xsd:string ;
            sh:description "Baliabidearen argitalpenaren bertsio-identifikatzailea." ;
            sh:group gax-validation:CorpusBasicInformationGroup ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Bertsioa" ;
            sh:order 4 ;
            sh:path dcat:version ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'corpus', 'legal', 'español', 'NER'" ;
            sh:datatype rdf:langString ;
            sh:description "Baliabidearen edukia eta domeinua deskribatzen dituzten gako-hitzak." ;
            sh:group gax-validation:CorpusBasicInformationGroup ;
            sh:maxCount 10 ;
            sh:minCount 1 ;
            sh:name "Gako-hitza" ;
            sh:order 5 ;
            sh:path dcat:keyword ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'ms:text', 'ms:audio', 'ms:video'" ;
            sh:description "Baliabidearen edukiaren euskarri mota (ms:MediaTypeTaxonomy-tik)." ;
            sh:group gax-validation:CorpusBasicInformationGroup ;
            sh:in ( ms:audio ms:image ms:text ms:textNumerical ms:video ) ;
            sh:minCount 1 ;
            sh:name "Euskarri mota" ;
            sh:order 6 ;
            sh:path ms:mediaType ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'ms:monolingual', 'ms:bilingual', 'ms:multilingual'" ;
            sh:description "Baliabidea elebakarra, elebiduna ala eleaniztuna den adierazten du (ms:LingualityTypeTaxonomy-tik)." ;
            sh:group gax-validation:CorpusBasicInformationGroup ;
            sh:in ( ms:bilingual ms:bilingualized ms:monolingual ms:multilingual ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Hizkuntza-kopuru mota" ;
            sh:order 7 ;
            sh:path ms:lingualityType ],
        [ skos:example "'ES-Legal-Corpus'" ;
            sh:datatype rdf:langString ;
            sh:description "Baliabidearen izenburu alternatiboa edo akronimoa." ;
            sh:group gax-validation:CorpusIdentificationGroup ;
            sh:name "Izenburu alternatiboa" ;
            sh:order 8 ;
            sh:path dct:alternative ],
        [ skos:example "'(adms:Identifier motako objektu bat skos:notation eta adms:schemaAgency-rekin)'" ;
            sh:description "Baliabidearen ADMS identifikatzailea(k) (adib., DOI, Handle, ISNI, ROR)." ;
            sh:group gax-validation:CorpusIdentificationGroup ;
            sh:name "Identifikatzailea" ;
            sh:node gax-validation:IdentifierShape ;
            sh:order 9 ;
            sh:path adms:identifier ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "" ;
            sh:description "Corpusean ordezkatutako hizkuntza(k) zehazten dituzten hizkuntza-metadatuak (meta-share) (ms:LanguageTaxonomy-tik). Hizkuntza anitz zehaztu daitezke corpus eleaniztunetarako." ;
            sh:group gax-validation:CorpusLanguageGroup ;
            sh:minCount 1 ;
            sh:name "Hizkuntza" ;
            sh:node gax-validation:LanguageShape ;
            sh:order 10 ;
            sh:path ms:language ],
        [ skos:example "'ms:yesA', 'ms:noA', 'ms:unknownA'" ;
            sh:description "Baliabidea anonimizatu den adierazten du (ms:AnonymizedTaxonomy-tik)." ;
            sh:group gax-validation:CorpusDataProtectionGroup ;
            sh:in ( ms:noA ms:unknownA ms:yesA ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Anonimizatua" ;
            sh:order 11 ;
            sh:path ms:anonymized ],
        [ skos:example "'ms:yesP', 'ms:noP', 'ms:unknownP'" ;
            sh:description "Baliabideak datu pertsonalak dituen adierazten du EBDOren arabera (ms:PersonalDataIncludedTaxonomy-tik). Nahitaezkoa EBDO betetzeko. Ezin da ezarri anonymized yesA bada." ;
            sh:group gax-validation:CorpusDataProtectionGroup ;
            sh:in ( ms:noP ms:unknownP ms:yesP ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Datu pertsonalak biltzen ditu" ;
            sh:order 12 ;
            sh:path ms:personalDataIncluded ],
        [ skos:example "'dpv:Encryption', 'dpv:Pseudonymisation', 'dpv:AccessControlPolicy'" ;
            sh:description "Datu pertsonalak babesteko aplikatutako neurri tekniko edo antolakuntzakoa (ms:TechnicalOrganisationalMeasureTaxonomy-tik). Nahitaezkoa personalDataIncluded yesP denean." ;
            sh:group gax-validation:CorpusDataProtectionGroup ;
            sh:in ( ms:accessControlsAuthenticationMechanisms ms:dataBackupAndRecoveryProcedures ms:dataBreachNotificationMechanisms ms:dataRetentionAndDeletionPolicies ms:encryptionOfPersonalData ms:incidentResponseAndManagementProcedures ms:networkAndCommunicationSecurity ms:physicalSecurityMeasuresForPremisesAndEquipment ms:pseudonymisationOfPersonalData ms:staffTrainingOnDataProtectionAndSecurityAwareness ) ;
            sh:name "Neurri tekniko edo antolakuntzakoa" ;
            sh:order 13 ;
            sh:path dpv:hasTechnicalOrganisationalMeasure ],
        [ skos:example "'Nombres y ubicaciones reemplazados con marcadores de posición utilizando spaCy NER'" ;
            sh:datatype rdf:langString ;
            sh:description "Baliabideari aplikatutako anonimizazio-prozesuaren testu libreko deskribapena." ;
            sh:group gax-validation:CorpusDataProtectionGroup ;
            sh:name "Anonimizazioaren xehetasunak" ;
            sh:order 14 ;
            sh:path ms:anonymizationDetails ],
        [ skos:example "'ms:yesS', 'ms:noS', 'ms:unknownS'" ;
            sh:description "Baliabideak datu sentikorrak dituen adierazten du (ms:SensitiveDataIncludedTaxonomy-tik). Nahitaezkoa EBDO betetzeko. Ezin da ezarri anonymized yesA bada." ;
            sh:group gax-validation:CorpusDataProtectionGroup ;
            sh:in ( ms:noS ms:unknownS ms:yesS ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Datu sentikorrak biltzen ditu" ;
            sh:order 15 ;
            sh:path ms:sensitiveDataIncluded ],
        [ skos:example "'Contiene registros de diagnósticos médicos'" ;
            sh:datatype rdf:langString ;
            sh:description "Baliabidean dauden datu sentikorren testu libreko deskribapena." ;
            sh:group gax-validation:CorpusDataProtectionGroup ;
            sh:name "Datu sentikorren xehetasunak" ;
            sh:order 16 ;
            sh:path ms:sensitiveDataDetails ],
        [ skos:example "'Contiene nombres de textos biográficos anotados'" ;
            sh:datatype rdf:langString ;
            sh:description "Baliabidean dauden datu pertsonalen testu libreko deskribapena." ;
            sh:group gax-validation:CorpusDataProtectionGroup ;
            sh:name "Datu pertsonalen xehetasunak" ;
            sh:order 17 ;
            sh:path ms:personalDataDetails ],
        [ skos:example "'ms:dataPurposeLimitation', 'ms:dataMinimisation'" ;
            sh:description "Baliabideari aplikatutako datu-babes printzipioa (ms:DataProtectionPrincipleTaxonomy-tik). Nahitaezkoa personalDataIncluded yesP denean." ;
            sh:group gax-validation:CorpusDataProtectionGroup ;
            sh:in ( ms:accuracy ms:alignmentDataRights ms:dataMinimisation ms:integrityConfidentiality ms:lawfulnessFairnessTransparency ms:purposeLimitation ms:storageLimitation ) ;
            sh:name "Aplikatutako datu-babes printzipioa" ;
            sh:order 18 ;
            sh:path ms:dataProtectionPrincipleApplied ],
        [ skos:example "'Compilado a partir de reseñas de usuarios de booking.com recopiladas en 2018'" ;
            sh:datatype rdf:langString ;
            sh:description "Baliabidea zein jatorrizko iturritatik eratorri zen adierazten duen testu libreko deskribapena." ;
            sh:group gax-validation:CorpusDataProtectionGroup ;
            sh:name "Jatorrizko iturriaren deskribapena" ;
            sh:order 19 ;
            sh:path ms:originalSourceDescription ],
        [ skos:example "'(dcat:Distribution motako objektu bat izenburuarekin, deskribapenarekin, formatuarekin, accessURL-arekin, etab.)'" ;
            sh:description "Corpusaren banaketa(k), hau da, eskuragarri dauden formatuak eta sarbide-URLak." ;
            sh:group gax-validation:CorpusDistributionGroup ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Banaketa" ;
            sh:node gax-validation:DistributionShape ;
            sh:order 20 ;
            sh:path dcat:distribution ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'ms:rawCorpus', 'ms:annotatedCorpus'" ;
            sh:description "Corpus azpiklase espezifikoa (gordina, anotatua, lerrokatua, paraleloa, konparagarria, etab.) ms:CorpusSubclassTaxonomy-tik." ;
            sh:group gax-validation:CorpusClassificationGroup ;
            sh:in ( ms:annotatedCorpus ms:annotationsCorpus ms:other ms:rawCorpus ms:unspecified ) ;
            sh:maxCount 1 ;
            sh:name "Corpus azpiklasea" ;
            sh:order 21 ;
            sh:path ms:corpusSubclass ],
        [ skos:example "'http://publications.europa.eu/resource/authority/country/ESP'" ;
            sh:description "Corpusaren estaldura espaziala (adib., datuetan ordezkatutako eremu geografikoa), IRI gisa adierazia." ;
            sh:group gax-validation:CorpusClassificationGroup ;
            sh:in ( continent:AFRICA continent:AMERICA continent:ANTARCTICA continent:ASIA continent:EUROPE continent:OCEANIA continent:OP_DATPRO country:1A0 country:ABW country:AFG country:AFI country:AGO country:AIA country:ALA country:ALB country:AND country:ANT country:ARE country:ARG country:ARM country:ASM country:ATA country:ATB country:ATF country:ATG country:ATN country:AUS country:AUT country:AZE country:BDI country:BEL country:BEN country:BES country:BFA country:BGD country:BGR country:BHR country:BHS country:BIH country:BLM country:BLR country:BLZ country:BMU country:BOL country:BRA country:BRB country:BRN country:BTN country:BUR country:BVT country:BWA country:BYS country:CAF country:CAN country:CCK country:CHE country:CHL country:CHN country:CIV country:CMR country:COD country:COG country:COK country:COL country:COM country:CPT country:CPV country:CRI country:CRQ country:CSK country:CTE country:CUB country:CUW country:CXR country:CYM country:CYP country:CZE country:DDR country:DEU country:DHY country:DJI country:DMA country:DNK country:DOM country:DZA country:ECU country:EGY country:ERI country:ESH country:ESP country:EST country:ETH country:EUR country:FIN country:FJI country:FLK country:FQ0 country:FRA country:FRO country:FSM country:FXX country:GAB country:GBR country:GEL country:GEO country:GGY country:GHA country:GIB country:GIN country:GLP country:GMB country:GNB country:GNQ country:GRC country:GRD country:GRL country:GTM country:GUF country:GUM country:GUY country:HKG country:HMD country:HND country:HRV country:HTI country:HUN country:HVO country:IDN country:IMN country:IND country:IOT country:IRL country:IRN country:IRQ country:ISL country:ISR country:ITA country:JAM country:JEY country:JOR country:JPN country:JTN country:KAZ country:KEN country:KGZ country:KHM country:KIR country:KNA country:KOR country:KWT country:LAO country:LBN country:LBR country:LBY country:LCA country:LIE country:LKA country:LSO country:LTU country:LUX country:LVA country:MAC country:MAF country:MAR country:MCO country:MDA country:MDG country:MDV country:MEX country:MHL country:MID country:MKD country:MLI country:MLT country:MMR country:MNE country:MNG country:MNP country:MOZ country:MRT country:MSR country:MTQ country:MUS country:MWI country:MYS country:MYT country:NAM country:NCL country:NER country:NFK country:NGA country:NHB country:NIC country:NIU country:NLD country:NOR country:NPL country:NRU country:NTZ country:NZL country:OMN country:OP_DATPRO country:PAK country:PAN country:PCI country:PCN country:PCZ country:PER country:PHL country:PLW country:PNG country:POL country:PRI country:PRK country:PRT country:PRY country:PSE country:PUS country:PYF country:QAT country:REU country:RHO country:ROU country:RUS country:RWA country:SAU country:SCG country:SDN country:SEN country:SGP country:SGS country:SHN country:SJM country:SKM country:SLB country:SLE country:SLV country:SMR country:SOM country:SPM country:SRB country:SSD country:STP country:SUN country:SUR country:SVK country:SVN country:SWE country:SWZ country:SXM country:SYC country:SYR country:TCA country:TCD country:TGO country:THA country:TJK country:TKL country:TKM country:TLS country:TMP country:TON country:TTO country:TUN country:TUR country:TUV country:TWN country:TZA country:UGA country:UKR country:UMI country:URY country:USA country:UZB country:VAT country:VCT country:VDR country:VEN country:VGB country:VIR country:VNM country:VUT country:WAK country:WLF country:WSM country:XAC country:XAD country:XBA country:XBH country:XBI country:XCI country:XDST country:XEU country:XGS country:XHS country:XIC country:XIH country:XIN country:XJM country:XKA country:XKM country:XKX country:XLF country:XLI country:XLL country:XMA country:XMAZ country:XME country:XNC country:XNY country:XPA country:XPM country:XQP country:XQR country:XSC country:XSG country:XSL country:XSM country:XSV country:XUCT country:XWS country:XXA country:XXB country:XXC country:XXD country:XXE country:XXF country:XXG country:XXH country:XXI country:XXJ country:XXL country:XXM country:XXN country:XXO country:XXP country:XXR country:XXS country:XXT country:XXU country:XXV country:XXW country:XXY country:XXZ country:YEM country:YMD country:YUG country:ZAF country:ZAR country:ZMB country:ZR0 country:ZWE ) ;
            sh:name "Estaldura espaziala" ;
            sh:order 22 ;
            sh:path dct:spatial ],
        [ skos:example "'(dct:PeriodOfTime motako objektu bat startDate eta endDate-rekin)'" ;
            sh:description "Corpusaren estaldura tenporala, dct:PeriodOfTime gisa adierazia hasiera- eta amaiera-datekin." ;
            sh:group gax-validation:CorpusClassificationGroup ;
            sh:name "Estaldura tenporala" ;
            sh:node gax-validation:PeriodOfTimeShape ;
            sh:order 23 ;
            sh:path dct:temporal ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'ms:parallel', 'ms:comparable'" ;
            sh:description "Eleaniztasun mota lingualityType eleaniztuna denean (ms:MultilingualityTypeTaxonomy-tik)." ;
            sh:group gax-validation:CorpusClassificationGroup ;
            sh:in ( ms:comparable ms:multilingualSingleText ms:other ms:parallel ms:unspecified ) ;
            sh:maxCount 1 ;
            sh:name "Eleaniztasun mota" ;
            sh:order 24 ;
            sh:path ms:multilingualityType ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'omtd:morphologicalAnnotation', 'omtd:syntacticAnnotation', 'omtd:semanticAnnotation'" ;
            sh:description "Corpusan dagoen anotazio mota omtd:AnnotationTypeScheme taxonomiaren arabera." ;
            sh:group gax-validation:CorpusClassificationGroup ;
            sh:in ( omtd:AgriculturalEntity omtd:Alignment1 omtd:AllbusVariable omtd:AudienceReaction omtd:BiologicalActivity omtd:BiologicalEnity omtd:BodyMovement omtd:BrainRegion omtd:CertaintyLevel omtd:Chemical omtd:ChemicalEntity omtd:Chunk omtd:Citation omtd:Clause omtd:Compound omtd:ConstituencyTree omtd:Constituent omtd:Contradiction omtd:Coreference omtd:Date omtd:Dependency omtd:DependencyTree omtd:DerivationalFeature omtd:DialogueAct omtd:DiscourseAnnotationType omtd:DiscourseRelation omtd:DocumentAnnotationType omtd:DocumentSection omtd:DomainSpecificAnnotationType omtd:Emotion omtd:EntityMentionPair omtd:Event omtd:FacialExpression omtd:Facility omtd:Frequency omtd:Funding omtd:GazeEyeMovement omtd:Gene omtd:GeneFamily omtd:Geo-politicalEntity omtd:GrapeVariety omtd:Habitat omtd:HeadMovement omtd:HistoricalEvent omtd:IonicChannel omtd:IonicConductance omtd:IonicCurrent omtd:Keyword omtd:LanguageCode omtd:LanguageProficiencyLevel omtd:Lemma omtd:LexicalSemanticRelation omtd:LinguisticEntity omtd:LipMovement omtd:Location omtd:Marker omtd:Media omtd:Metabolite omtd:MethodOfResearch omtd:Miscellaneous omtd:ModalityAnnotationType omtd:ModelOrganism_species omtd:MorphologicalAnnotationType omtd:MorphologicalFeature omtd:MultiWordUnit omtd:NamedEntity omtd:Neuron omtd:NeuroscienceEntity omtd:OfficialText omtd:Organism omtd:Organization omtd:OrthographicTranscription1 omtd:Paragraph omtd:PartOfSpeech omtd:Person omtd:PersuasiveExpression omtd:Phenotype omtd:PhoneticTranscription1 omtd:Phrase omtd:PhysicoChemicalProperty omtd:Polarity omtd:ProsodicBoundary omtd:Protein omtd:ProteinFamily omtd:QuantititativeInformation omtd:QuestionTopicalTarget omtd:Readability omtd:Relation omtd:Rna omtd:ScholarlyAnalyticsEntity omtd:ScholarlyCommunicationAnnotation omtd:ScientificUnit omtd:ScientificValue omtd:SemanticAnnotationType omtd:SemanticClass omtd:SemanticFrame omtd:SemanticRole omtd:Sentence omtd:Sentiment omtd:SocialSciencesEntity omtd:Species omtd:SpectralData omtd:SpeechAct omtd:SpeechAnnotationType omtd:Stem omtd:StructuralAnnotationType omtd:SubcategorizationFrame omtd:Subjectivity omtd:Synapse omtd:SyntacticAnnotationType omtd:SyntacticoSemanticLink omtd:TemporalExpression omtd:Term omtd:TextualEntailment omtd:TheoreticalFrame omtd:Token omtd:Topic omtd:Transcription1 omtd:VerbalAggressionTarget omtd:WheatRelatedSpecies omtd:Word omtd:WordSense omtd:other omtd:unspecified ) ;
            sh:name "Anotazio mota" ;
            sh:order 25 ;
            sh:path ms:annotationType ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'ms:law', 'ms:medicine', 'ms:science'" ;
            sh:description "Baliabideak hartzen duen domeinua edo arloa (ms:DomainTaxonomy-tik)." ;
            sh:group gax-validation:CorpusClassificationGroup ;
            sh:in ( ms:AgricultureAndFisheries ms:EconomyAndFinancialMarkets_Services ms:EnvironmentEnergyAndSustainability ms:HealthAndWellbeing ms:ICTInfrastructure ms:Industry ms:LearningAndEducation ms:MediaCommunicationWebAndEntertainment ms:MobilityAndTransportation ms:PublicSectorAndCitizenServices ms:SafetyAndSecurity ms:ScientificResearchDesignAndEngineering ms:other ms:unspecified ) ;
            sh:name "Domeinua" ;
            sh:order 26 ;
            sh:path ms:domain ],
        [ skos:example "'ms:TEI', 'ms:ISO24622', 'ms:CLARIN'" ;
            sh:description "Corpusak betetzen duen estandarra edo praktika ona (ms:StandardBestPracticeTaxonomy-tik)." ;
            sh:group gax-validation:CorpusClassificationGroup ;
            sh:in ( ms:BML ms:CES ms:CLARIN-SHARE ms:EAGLES ms:ELG-SHARE ms:EML ms:EMMA ms:GMX ms:GrAF ms:HamNoSys ms:ISO12620 ms:ISO16642 ms:ISO1987 ms:ISO26162 ms:ISO30042 ms:ISO704 ms:InkML ms:LAF ms:LMF ms:LemonOntolex ms:MAF ms:MLIF ms:MMI ms:MULTEXT ms:MUMIN ms:OAXAL ms:SRX ms:SemAF ms:SemAF-DA ms:SemAF-DS ms:SemAF-NE ms:SemAF-SR ms:SynAF ms:TBX ms:TEI ms:TEI_P3 ms:TEI_P4 ms:TEI_P5 ms:TMX ms:TimeML ms:XCES ms:XLIFF ms:other ms:pennTreeBank ms:pragueTreebank ms:unspecified ms:wordNet ) ;
            sh:name "Honako honi egokitzen zaio" ;
            sh:order 27 ;
            sh:path dct:conformsTo ],
        [ skos:example "'(dct:LicenseDocument motako objektu bat)'" ;
            sh:description "Corpusa zer lizentziaren arabera jartzen den eskuragarri (dct:license)." ;
            sh:group gax-validation:CorpusLicenseGroup ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Lizentzia" ;
            sh:node gax-validation:LicenseDocumentShape ;
            sh:order 28 ;
            sh:path dct:license ],
        [ skos:example "'(foaf:Organization motako objektu bat)'" ;
            sh:description "Corpusa argitaratzen edo eskuragarri jartzen duen erakundea (dct:publisher)." ;
            sh:group gax-validation:CorpusPublisherGroup ;
            sh:maxCount 1 ;
            sh:name "Argitaratzailea" ;
            sh:node gax-validation:OrganizationShape ;
            sh:order 29 ;
            sh:path dct:publisher ],
        [ skos:example "'(foaf:Organization motako objektu bat foaf:name eta adms:identifier-ekin)'" ;
            sh:description "Corpusaren jabetza intelektualeko eskubideen titularra(k) (LanguageDCAT-AP ms:iprHolder)." ;
            sh:group gax-validation:CorpusIntellectualPropertyRightsGroup ;
            sh:name "Eskubideen titularra" ;
            sh:node gax-validation:OrganizationShape ;
            sh:order 30 ;
            sh:path ms:iprHolder ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "" ;
            sh:description "Corpus paralelo/eleaniztun baten jatorri-hizkuntza(k) (LanguageDCAT-AP ms:sourceLanguage)." ;
            sh:group gax-validation:CorpusSourceLanguageGroup ;
            sh:name "Jatorri-hizkuntza" ;
            sh:node gax-validation:LanguageShape ;
            sh:order 31 ;
            sh:path ms:sourceLanguage ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "" ;
            sh:description "Corpus paralelo/eleaniztun baten xede-hizkuntza(k) (LanguageDCAT-AP ms:targetLanguage)." ;
            sh:group gax-validation:CorpusTargetLanguageGroup ;
            sh:name "Xede-hizkuntza" ;
            sh:node gax-validation:LanguageShape ;
            sh:order 32 ;
            sh:path ms:targetLanguage ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "" ;
            sh:description "Corpus paralelo/eleaniztun batean bitarteko ordezkapen gisa erabilitako hizkuntza pibotea(k) (LanguageDCAT-AP ms:pivotLanguage)." ;
            sh:group gax-validation:CorpusPivotLanguageGroup ;
            sh:name "Hizkuntza pibotea" ;
            sh:node gax-validation:LanguageShape ;
            sh:order 33 ;
            sh:path ms:pivotLanguage ],
        [ skos:example "" ;
            sh:description "Hizkuntza-baliabide bat dokumentu batekin lotzen du (adib., bere edukia edo proiektu batean duen erabilera deskribatzen duen ikerketa-artikulua, erabiltzaile-eskuliburua, etab.) edo baliabidearekin lotutako beste edozein dokumentazio-mota (adib., laguntza-informazioa duen URL bat)." ;
            sh:group gax-validation:CorpusDocumentationGroup ;
            sh:name "Honek dokumentatua" ;
            sh:node gax-validation:DocumentShape ;
            sh:order 34 ;
            sh:path ms:isDocumentedBy ] ;
    sh:targetClass ms:Corpus .

gax-validation:CorpusSourceLanguageGroup a sh:PropertyGroup ;
    rdfs:label "Sorburu-hizkuntza" ;
    sh:order 10 .

gax-validation:CorpusTargetLanguageGroup a sh:PropertyGroup ;
    rdfs:label "Xede-hizkuntza" ;
    sh:order 11 .

gax-validation:DataPropertiesShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'http://provenanceURL.eu'" ;
            sh:datatype xsd:anyURI ;
            sh:description "Jatorria." ;
            sh:maxCount 1 ;
            sh:name "Honek ekoitzia" ;
            sh:order 1 ;
            sh:path simpl:producedBy ;
            sh:pattern "^([Hh][Tt][Tt][Pp][Ss]?):\\/\\/(?:www\\.)?[A-Za-z0-9][-A-Za-z0-9@:%_\\+~#=\\.]{0,255}\\.[A-Za-z0-9()]{1,6}\\b(?:[-A-Za-z0-9()@:%_\\+.~#?&/=]*)$" ],
        [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'csv, xml'" ;
            sh:datatype xsd:string ;
            sh:description "Datuak zer formatutan banatzen diren (adib., csv, xml, …)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Formatua" ;
            sh:order 2 ;
            sh:path simpl:format ;
            sh:pattern "^[a-zA-Z0-9][a-zA-Z0-9\\s]*$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'http://mysite/swagger-ui/index.html'" ;
            sh:datatype xsd:anyURI ;
            sh:description "Datu-multzoaren eskema; datu motaren araberakoa da: JSONerako, datuek zer eremu eta mota dituzten adierazten dituen JSON Schema deskribapena litzateke." ;
            sh:name "OpenAPI" ;
            sh:order 3 ;
            sh:path simpl:openApi ;
            sh:pattern "^([Hh][Tt][Tt][Pp][Ss]?):\\/\\/(?:www\\.)?[A-Za-z0-9][-A-Za-z0-9@:%_\\+~#=\\.]{0,255}\\.[A-Za-z0-9()]{1,6}\\b(?:[-A-Za-z0-9()@:%_\\+.~#?&/=]*)$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'http://mysite/swagger-ui/index.html'" ;
            sh:datatype xsd:anyURI ;
            sh:description "Datu-multzoari buruzko informazio gehigarria." ;
            sh:maxCount 1 ;
            sh:name "Informazio gehigarria" ;
            sh:order 4 ;
            sh:path simpl:additionalInfo ;
            sh:pattern "^([Hh][Tt][Tt][Pp][Ss]?):\\/\\/(?:www\\.)?[A-Za-z0-9][-A-Za-z0-9@:%_\\+~#=\\.]{0,255}\\.[A-Za-z0-9()]{1,6}\\b(?:[-A-Za-z0-9()@:%_\\+.~#?&/=]*)$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'Text'" ;
            sh:datatype xsd:string ;
            sh:description "Erlazionatutako datu-multzoak." ;
            sh:name "Erlazionatutako datu-multzoak" ;
            sh:order 5 ;
            sh:path simpl:relatedDatasets ;
            sh:pattern "^[a-zA-Z0-9][a-zA-Z0-9\\s]*$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'Text'" ;
            sh:datatype xsd:string ;
            sh:description "Xede-erabiltzaileak." ;
            sh:name "Xede-erabiltzaileak" ;
            sh:order 6 ;
            sh:path simpl:targetUsers ;
            sh:pattern "^[a-zA-Z0-9][a-zA-Z0-9\\s]*$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'Text'" ;
            sh:datatype xsd:string ;
            sh:description "Datuen kalitatea (osotasuna, zehaztasuna, eguneratasuna eta beste metrika batzuk biltzen ditu)." ;
            sh:name "Datuen kalitatea" ;
            sh:order 7 ;
            sh:path simpl:dataQuality ;
            sh:pattern "^[a-zA-Z0-9][a-zA-Z0-9\\s]*$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'Text'" ;
            sh:datatype xsd:string ;
            sh:description "Zifratzea: datuak babesteko erabilitako zifratze-algoritmoak eta gakoak deskribatzen ditu." ;
            sh:maxCount 1 ;
            sh:name "Zifratzea" ;
            sh:order 8 ;
            sh:path simpl:encryption ;
            sh:pattern "^[a-zA-Z0-9][a-zA-Z0-9\\s]*$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'Text'" ;
            sh:datatype xsd:string ;
            sh:description "Anonimizazioa/pseudonimizazioa: informazio sentikorra pribatutasuna babesteko anonimizatu edo pseudonimizatu den adierazten du." ;
            sh:maxCount 1 ;
            sh:name "Anonimizazioa" ;
            sh:order 9 ;
            sh:path simpl:anonymization ;
            sh:pattern "^[a-zA-Z0-9][a-zA-Z0-9\\s]*$" ] ;
    sh:targetClass simpl:DataProperties .

gax-validation:DistributionShape a sh:NodeShape ;
    sh:property [ skos:example "'omtd:Csv', 'omtd:Json', 'omtd:Xml'" ;
            sh:description "Banaketaren datu-formatua: omtd:DataFormatScheme-ko IRI bat (adib., omtd:Csv, omtd:Json, omtd:Xml)." ;
            sh:in ( omtd:ANNIS omtd:AclAnthologyCorpusFormat omtd:AimedCorpusFormat omtd:Alto omtd:AlvisEnrichedDocumentFormat omtd:Anafora omtd:AnnotationFormat omtd:AudioFormat omtd:Avro_json omtd:BLAST omtd:BinaryCas omtd:BinaryFormat omtd:Bionlp omtd:BionlpFormat omtd:BionlpSt2013A1_a2 omtd:Blikiwikipedia omtd:BncFormat omtd:Brat omtd:CBOR omtd:Cadixe_json omtd:Chat omtd:Cochrane omtd:Conll2000 omtd:Conll2002 omtd:Conll2003 omtd:Conll2006 omtd:Conll2008 omtd:Conll2009 omtd:Conll2012 omtd:ConllFormat omtd:ConllU omtd:CorpusFormat omtd:Csv omtd:DatabaseFormat omtd:Datasift_json omtd:Diaml omtd:DkproTokenized omtd:DocumentFormat omtd:EAF omtd:Emma omtd:FactoredTagLemFormat omtd:FastInfoset omtd:Folia omtd:GateFormat omtd:GateXml omtd:Gate_twitter_json omtd:Graf omtd:Gzip omtd:Html omtd:Html5Microdata omtd:I2b2 omtd:ImageFormat omtd:Imscwb omtd:InlineXml omtd:Jdbc omtd:Json omtd:JsonL omtd:Json_genia omtd:Kaf omtd:KeaCorpus omtd:LD_json omtd:Latex omtd:LinkedDataFormat omtd:Lll omtd:MLModelFormat omtd:MOSESFormat omtd:MalletLdaTopicProportions omtd:MalletLdaTopicProportionsSorted omtd:MediaWikiMarkup omtd:MsAccessDatabase omtd:MsExcel omtd:MsExcel_xlsx omtd:MsPowerpoint omtd:MsWord omtd:MsWord_docx omtd:Naf omtd:NegraExport omtd:Nif omtd:ONNX omtd:OasisPresentation omtd:OasisSpreadsheet omtd:OasisText omtd:Obo omtd:OpenFormat omtd:OpenOfficeDocument omtd:OpenOfficePresentation omtd:OpenOfficeSpreadsheet omtd:Owl omtd:Owl_xml omtd:PackageFormat omtd:Pdf omtd:Pls omtd:Pml omtd:Postscript omtd:Ptb omtd:PtbChunked omtd:PtbCombined omtd:Pubmed omtd:RawAudioFormat omtd:RdfFormat omtd:Rdf_xml omtd:Reuters21578Sgml omtd:Reuters21578Txt omtd:Rtf omtd:SDL_tm_xliff omtd:SQL omtd:SerializedCas omtd:Sgml omtd:Solr omtd:TFSavedModel omtd:TabularFormat omtd:Tbx omtd:Tcf omtd:Tei omtd:Tex omtd:Text omtd:TextXML omtd:Tgrep2 omtd:Tgz omtd:TigerXml omtd:Tika omtd:Tmx omtd:Tsv omtd:Tuepp omtd:Turtle omtd:UimaCasFormat omtd:Uima_json omtd:VideoFormat omtd:WARC omtd:Web1t omtd:WebAnnotationFormat omtd:WikiFormat omtd:WikipediaArticle omtd:WikipediaArticleInfo omtd:WikipediaDiscussion omtd:WikipediaFormat omtd:WikipediaLink omtd:WikipediaPage omtd:WikipediaQuery omtd:WikipediaRevision omtd:WikipediaRevisionPair omtd:WikipediaTemplateFilteredArticle omtd:Xces omtd:XcesIlspVariant omtd:Xhtml omtd:Xmi omtd:Xml omtd:XmlBioc omtd:Xpath omtd:Zip omtd:aif omtd:avi omtd:basic omtd:bmp omtd:flac omtd:gif omtd:hdf5 omtd:jpg omtd:mleap omtd:mp3 omtd:mp4 omtd:mpg omtd:octetStream omtd:other omtd:pkl omtd:pmml omtd:png omtd:protoBuf omtd:protoBuf_Json omtd:svg omtd:tar omtd:tiff omtd:unspecified omtd:wav omtd:yaml omtd:xml ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Formatua" ;
            sh:order 1 ;
            sh:path dct:format ],
        [ skos:example "'omtd:Zip', 'omtd:Gzip', 'omtd:Tgz'" ;
            sh:description "Paketatze-/konpresio-formatua (omtd:PackageFormatScheme-tik)." ;
            sh:in ( omtd:Gzip omtd:Tgz omtd:Zip omtd:other omtd:tar omtd:unspecified omtd:zip ) ;
            sh:maxCount 1 ;
            sh:name "Paketatze-formatua" ;
            sh:order 2 ;
            sh:path dcat:packageFormat ],
        [ skos:example "'1048576', '524288000'" ;
            sh:datatype xsd:integer ;
            sh:description "Banaketaren tamaina bytetan (positiboa izan behar du)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Tamaina bytetan" ;
            sh:order 3 ;
            sh:path dcat:byteSize ],
        [ skos:example "'(SizeWithUnit motako objektu bat amount eta sizeUnit-ekin)'" ;
            sh:description "Tamaina irakurgarria bere unitatearekin." ;
            sh:minCount 1 ;
            sh:name "Tamaina" ;
            sh:node gax-validation:SizeShape ;
            sh:order 4 ;
            sh:path ms:size ] ;
    sh:targetClass dcat:Distribution .

gax-validation:DocumentDocumentationGroup a sh:PropertyGroup ;
    rdfs:label "Dokumentazioa" ;
    sh:order 1 .

gax-validation:DocumentShape a sh:NodeShape ;
    sh:property [ skos:example "'Smith, J. et al. (2023). Spanish Legal Corpus v1.0. Journal of Language Resources.'" ;
            sh:datatype rdf:langString ;
            sh:description "Dokumentazioaren testu libreko aipamena." ;
            sh:group gax-validation:DocumentDocumentationGroup ;
            sh:minCount 1 ;
            sh:name "Aipamen-testua" ;
            sh:order 1 ;
            sh:path ms:citationText ] ;
    sh:targetClass foaf:Document .

gax-validation:EdcConnectorShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'providerEndpointURL'" ;
            sh:datatype xsd:string ;
            sh:description "Hornitzailearen endpoint URLa." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Hornitzailearen endpoint URLa" ;
            sh:order 1 ;
            sh:path simpl:providerEndpointURL ] ;
    sh:targetClass simpl:EdcConnector .

gax-validation:EdcRegistrationShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'Identifier'" ;
            sh:datatype xsd:string ;
            sh:description "Kontratu-definizioaren identifikatzaile bakarra." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Kontratu-definizioaren IDa" ;
            sh:order 1 ;
            sh:path simpl:contractDefinitionId ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'Identifier'" ;
            sh:datatype xsd:string ;
            sh:description "Zerbitzu-politikaren identifikatzaile bakarra." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Zerbitzu-politikaren IDa" ;
            sh:order 2 ;
            sh:path simpl:servicePolicyId ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'Identifier'" ;
            sh:datatype xsd:string ;
            sh:description "Sarbide-politikaren identifikatzaile bakarra." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Sarbide-politikaren IDa" ;
            sh:order 3 ;
            sh:path simpl:accessPolicyId ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'Identifier'" ;
            sh:datatype xsd:string ;
            sh:description "Aktiboaren identifikatzaile bakarra." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Aktiboaren IDa" ;
            sh:order 4 ;
            sh:path simpl:assetId ] ;
    sh:targetClass simpl:EdcRegistration .

gax-validation:GeneralServicePropertiesShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'Title'" ;
            sh:datatype xsd:string ;
            sh:description "Datu-multzoaren/aplikazioaren/azpiegituraren testu-titulu laburra." ;
            sh:maxCount 1 ;
            sh:maxLength 255 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "Izena" ;
            sh:order 1 ;
            sh:path simpl:name ;
            sh:pattern "^(.|\\s)*[a-zA-Z]+(.|\\s)*$" ],
        [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'Description'" ;
            sh:datatype xsd:string ;
            sh:description "Datu-multzoaren/aplikazioaren/azpiegituraren deskribapena." ;
            sh:maxCount 1 ;
            sh:maxLength 1000 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "Deskribapena" ;
            sh:order 2 ;
            sh:path simpl:description ;
            sh:pattern "^(.|\\s)*[a-zA-Z]+(.|\\s)*$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'URL, handle'" ;
            sh:datatype xsd:anyURI ;
            sh:description "Datu-multzoa/aplikazioa/azpiegitura aurki daitekeen kokapena (ziurrenik endpoint URL bat)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Zerbitzura sartzeko puntua" ;
            sh:order 3 ;
            sh:path simpl:serviceAccessPoint ;
            sh:pattern "^([Hh][Tt][Tt][Pp][Ss]?):\\/\\/(?:www\\.)?[A-Za-z0-9][-A-Za-z0-9@:%_\\+~#=\\.]{0,255}\\.[A-Za-z0-9()]{1,6}\\b(?:[-A-Za-z0-9()@:%_\\+.~#?&/=]*)$" ],
        [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'Keywords'" ;
            sh:datatype xsd:string ;
            sh:description "Gako-hitzak." ;
            sh:maxCount 16 ;
            sh:maxLength 50 ;
            sh:minLength 1 ;
            sh:name "Gako-hitzak" ;
            sh:order 4 ;
            sh:path simpl:keywords ;
            sh:pattern "^(.|\\s)*[a-zA-Z]+(.|\\s)*$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'EN, IT'" ;
            sh:datatype xsd:string ;
            sh:description "Hizkuntza (metadatuena, hala nola izenburua edo deskribapena)." ;
            sh:in ( "es" "gl" "ca" "eu" "en" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Hizkuntza" ;
            sh:order 5 ;
            sh:path simpl:inLanguage ],
        [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'application, data, infrastructure'" ;
            sh:datatype xsd:string ;
            sh:description "Bilaketarako erabiltzen den eskaintza mota." ;
            sh:in ( "application" "data" "infrastructure" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Eskaintza mota" ;
            sh:order 6 ;
            sh:path simpl:offeringType ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'Id'" ;
            sh:datatype xsd:string ;
            sh:description "Baliabidearen helbide-txantiloirako erabiltzen den partekatze-metodoaren IDa." ;
            sh:maxCount 1 ;
            sh:name "Partekatze-metodoaren IDa" ;
            sh:order 7 ;
            sh:path simpl:sharingMethodId ] ;
    sh:targetClass simpl:GeneralServiceProperties .

gax-validation:LicenseDocumentShape a sh:NodeShape ;
    sh:property [ skos:example "'Creative Commons Attribution 4.0 International'" ;
            sh:datatype rdf:langString ;
            sh:description "Lizentziaren izenburu irakurgarria" ;
            sh:minCount 1 ;
            sh:name "Izenburua" ;
            sh:order 1 ;
            sh:path dct:title ],
        [ skos:example "'Permite compartir y adaptar con atribución.'" ;
            sh:datatype rdf:langString ;
            sh:description "Lizentziaren deskribapen irakurgarria" ;
            sh:minCount 1 ;
            sh:name "Deskribapena" ;
            sh:order 2 ;
            sh:path dct:description ],
        [ skos:example "'https://creativecommons.org/licenses/by/4.0/legalcode'" ;
            sh:datatype xsd:anyURI ;
            sh:description "Lizentziaren lege-kodearen/testu osoaren IRIa (cc:legalcode)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Lege-kodea" ;
            sh:order 3 ;
            sh:path cc:legalcode ;
            sh:pattern "^([Hh][Tt][Tt][Pp][Ss]?):\\/\\/(?:www\\.)?[A-Za-z0-9][-A-Za-z0-9@:%_\\+~#=\\.]{0,255}\\.[A-Za-z0-9()]{1,6}\\b(?:[-A-Za-z0-9()@:%_\\+.~#?&/=]*)$" ],
        [ skos:example "'(adms:Identifier motako objektu bat skos:notation eta adms:schemaAgency-rekin)'" ;
            sh:description "Lizentzia-dokumentuaren ADMS identifikatzailea(k)." ;
            sh:name "Identifikatzailea" ;
            sh:node gax-validation:IdentifierShape ;
            sh:order 4 ;
            sh:path adms:identifier ] ;
    sh:targetClass dct:LicenseDocument .

gax-validation:OfferingPriceShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'www.simpl.com'" ;
            sh:datatype xsd:anyURI ;
            sh:description "Erabilitako lizentziaren URLa." ;
            sh:maxLength 255 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "Lizentzia" ;
            sh:order 1 ;
            sh:path simpl:license ;
            sh:pattern "^([Hh][Tt][Tt][Pp][Ss]?):\\/\\/(?:www\\.)?[A-Za-z0-9][-A-Za-z0-9@:%_\\+~#=\\.]{0,255}\\.[A-Za-z0-9()]{1,6}\\b(?:[-A-Za-z0-9()@:%_\\+.~#?&/=]*)$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'BGN, EUR, CZK'" ;
            sh:datatype xsd:string ;
            sh:description "Prezioaren moneta." ;
            sh:in ( "BGN" "EUR" "CZK" "DKK" "HUF" "PLN" "RON" "SEK" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Moneta" ;
            sh:order 2 ;
            sh:path simpl:currency ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'0, 1, 2'" ;
            sh:datatype xsd:decimal ;
            sh:description "Prezioa eta baldintzak." ;
            sh:maxCount 1 ;
            sh:maxInclusive 99999999999.0 ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:name "Prezioa" ;
            sh:order 3 ;
            sh:path simpl:price ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'free, commercial'" ;
            sh:datatype xsd:string ;
            sh:description "Prezio mota." ;
            sh:in ( "free" "commercial" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Prezio mota" ;
            sh:order 4 ;
            sh:path simpl:priceType ] ;
    sh:targetClass simpl:OfferingPrice .

gax-validation:PeriodOfTimeShape a sh:NodeShape ;
    sh:property [ skos:example "'2018-01-01'" ;
            sh:datatype xsd:date ;
            sh:description "Aldiaren hasiera-data (barne)." ;
            sh:maxCount 1 ;
            sh:name "Hasiera-data" ;
            sh:order 1 ;
            sh:path dcat:startDate ],
        [ skos:example "'2018-12-31'" ;
            sh:datatype xsd:date ;
            sh:description "Aldiaren amaiera-data (barne)." ;
            sh:maxCount 1 ;
            sh:name "Amaiera-data" ;
            sh:order 2 ;
            sh:path dcat:endDate ] ;
    sh:targetClass dct:PeriodOfTime .

gax-validation:ProviderInformationShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'123'" ;
            sh:datatype xsd:string ;
            sh:description "Datu-multzoaren/aplikazioaren/azpiegituraren hornitzailearen IDaren erreferentzia." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Honek emana" ;
            sh:order 1 ;
            sh:path simpl:providedBy ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'support'" ;
            sh:datatype xsd:string ;
            sh:description "Galderak edo arazoak izanez gero, norekin harremanetan jarri." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Kontaktua" ;
            sh:order 2 ;
            sh:path simpl:contact ;
            sh:pattern "^[\\w\\-\\.]+@([\\w-]+\\.)+[\\w-]{2,4}$" ],
        [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'signature'" ;
            sh:datatype xsd:string ;
            sh:description "Hornitzailea autodeskribapena igo zuena dela bermatzen duen sinadura digitala." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Sinadura" ;
            sh:order 3 ;
            sh:path simpl:signature ;
            sh:pattern "^[a-zA-Z0-9][a-zA-Z0-9\\s-]*$" ] ;
    sh:targetClass simpl:ProviderInformation .

gax-validation:ServicePolicyShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'ODRL policy'" ;
            sh:datatype xsd:string ;
            sh:description "Datu-multzora nork sar daitekeen zehazten duen sarbide-politika." ;
            sh:minCount 1 ;
            sh:name "Sarbide-politika" ;
            sh:order 1 ;
            sh:path simpl:access-policy ;
            sh:pattern "[:,\\{\\}\\[\\]]|(\".*?\")|('.*?')|[-\\w.]+" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'ODRL policy'" ;
            sh:datatype xsd:string ;
            sh:description "Datu-multzo bat nola erabil daitekeen zehazten duen erabilera-politika." ;
            sh:minCount 1 ;
            sh:name "Erabilera-politika" ;
            sh:order 2 ;
            sh:path simpl:usage-policy ;
            sh:pattern "[:,\\{\\}\\[\\]]|(\".*?\")|('.*?')|[-\\w.]+" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'Free text'" ;
            sh:datatype xsd:string ;
            sh:description "Datu-babeserako araudi eta estandar garrantzitsuak betetzen direla adierazten du." ;
            sh:name "Datu-babeserako araubidea" ;
            sh:order 3 ;
            sh:path simpl:dataProtectionRegime ;
            sh:pattern "[:,\\{\\}\\[\\]]|(\".*?\")|('.*?')|[-\\w.]+" ] ;
    sh:targetClass simpl:ServicePolicy .

gax-validation:SizeShape a sh:NodeShape ;
    sh:property [ skos:example "'1000000', '5432'" ;
            sh:datatype xsd:float ;
            sh:description "Zenbakizko kopurua (positiboa izan behar du)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Kopurua" ;
            sh:order 1 ;
            sh:path ms:amount ],
        [ skos:example "'ms:token', 'ms:word3', 'ms:text1'" ;
            sh:description "Neurketa-unitatea: ms:SizeUnitTaxonomy-ko IRI bat (adib., ms:token, ms:word3, ms:text1, ms:file, ms:gb)." ;
            sh:in ( ms:T-HPair ms:article ms:bigram ms:byte ms:class ms:concept ms:diphone1 ms:element ms:entry ms:expression ms:file ms:five-gram ms:four-gram ms:frame1 ms:gb ms:hour1 ms:idiomaticExpression ms:image2 ms:ingestedRecord ms:internalRecord ms:item ms:kb ms:keyword1 ms:lexicalType ms:mb ms:minute ms:multiWordUnit ms:neologism ms:other ms:parameter ms:phoneme2 ms:phoneticUnit ms:phrase1 ms:predicate ms:publishedRecord ms:question ms:rule ms:second ms:segment ms:semanticUnit1 ms:sentence1 ms:shot1 ms:syllable2 ms:synset ms:syntacticUnit1 ms:tb ms:term ms:text1 ms:token ms:translationUnit ms:trigram ms:triple ms:turn ms:unigram ms:unit ms:unspecified ms:utterance1 ms:word3 ms:tokens ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Tamaina-unitatea" ;
            sh:order 2 ;
            sh:path ms:sizeUnit ] ;
    sh:targetClass ms:Size .

gax-validation:CorpusIdentificationGroup a sh:PropertyGroup ;
    rdfs:label "Identifikazioa" ;
    sh:order 2 .

gax-validation:OrganizationShape a sh:NodeShape ;
    sh:property [ skos:example "'Fundación para la Transformación de la Rioja'" ;
            sh:datatype rdf:langString ;
            sh:description "Argitalpenaren arduradun den erakundearen izen legala." ;
            sh:minCount 1 ;
            sh:name "Argitaletxearen izena" ;
            sh:order 1 ;
            sh:path foaf:name ],
        [ skos:example "'(adms:Identifier motako objektu bat skos:notation eta adms:schemaAgency-rekin)'" ;
            sh:description "Erakundearen ADMS identifikatzailea(k) (adib., ISNI, ROR)." ;
            sh:name "Identifikatzailea" ;
            sh:node gax-validation:IdentifierShape ;
            sh:order 2 ;
            sh:path adms:identifier ] ;
    sh:targetClass foaf:Organization .

gax-validation:IdentifierShape a sh:NodeShape ;
    sh:property [ skos:example "'https://doi.org/10.57771/rnyr-fa06a', 'https://isni.org/isni/0000000121748431', 'CC-BY-NC-SA-4.0'" ;
            sh:datatype xsd:string ;
            sh:description "Identifikatzailearen balioa (adib., DOI, Handle, ISNI, ROR, SPDX). Kate librea, LanguageDCAT-AP-en bezala." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Notazioa" ;
            sh:order 1 ;
            sh:path skos:notation ],
        [ skos:example "''ISNI International Agency'@en', ''ROR'@en'" ;
            sh:datatype rdf:langString ;
            sh:description "Identifikatzailearen eskemaren ardura duen agentzia. Hizkuntza anitz onartzen ditu hizkuntza-etiketen bidez." ;
            sh:name "Eskemaren agentzia" ;
            sh:order 2 ;
            sh:path adms:schemaAgency ] ;
    sh:targetClass adms:Identifier .

