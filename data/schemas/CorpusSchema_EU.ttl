            sh:name "Hizkuntza-aldaeraren izena" ;
            sh:order 5 ;
            sh:path ms:languageVarietyName ],
        [ skos:example "'es-ES', 'ca-ES', 'zh-Hant-HK'" ;
            sh:datatype xsd:string ;
            sh:description "BCP47 hizkuntza-etiketaren katea, hizkuntza-kodeak eta, aukeran, eskualde-, idazkera- eta aldaera-azpietiketek osatua (adib., 'es-ES', 'ca-ES', 'zh-Hant-HK')." ;
            sh:group gax-validation:LanguageLanguageGroup ;
            sh:maxCount 1 ;
            sh:name "Hizkuntza-etiketa" ;
            sh:order 6 ;
            sh:path ms:languageTag ] ;
    sh:targetClass ms:Language .

gax-validation:LanguageLanguageGroup a sh:PropertyGroup ;
    rdfs:label "Hizkuntza" ;
    sh:order 1 .

