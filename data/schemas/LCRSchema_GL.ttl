            sh:name "Variante" ;
            sh:order 4 ;
            sh:path ms:variant ],
        [ skos:example "'Andaluz', 'Rioplatense', 'Valenciano'" ;
            sh:datatype rdf:langString ;
            sh:description "Nome libre de calquera variedade lingüística ou dialecto, incluídos os que non teñen un subtag BCP47 rexistrado (p. ex., andaluz, rioplatense, canario)." ;
            sh:group gax-validation:LanguageLanguageGroup ;
            sh:name "Nome da variedade lingüística" ;
            sh:order 5 ;
            sh:path ms:languageVarietyName ],
        [ skos:example "'es-ES', 'ca-ES', 'zh-Hant-HK'" ;
            sh:datatype xsd:string ;
            sh:description "Cadea de etiqueta de idioma BCP47 composta polo código de idioma e, opcionalmente, os subtags de rexión, escritura e variante (p. ex., 'es-ES', 'ca-ES', 'zh-Hant-HK')." ;
            sh:group gax-validation:LanguageLanguageGroup ;
            sh:maxCount 1 ;
            sh:name "Etiqueta de idioma" ;
            sh:order 6 ;
            sh:path ms:languageTag ] ;
    sh:targetClass ms:Language .

gax-validation:LanguageLanguageGroup a sh:PropertyGroup ;
    rdfs:label "Idioma" ;
    sh:order 1 .

gax-validation:LexicalConceptualResourceBasicInformationGroup a sh:PropertyGroup ;
    rdfs:label "Información básica" ;
    sh:order 1 .

gax-validation:LexicalConceptualResourceClassificationGroup a sh:PropertyGroup ;
    rdfs:label "Clasificación" ;
    sh:order 6 .

gax-validation:LexicalConceptualResourceDataProtectionGroup a sh:PropertyGroup ;
    rdfs:label "Protección de datos" ;
    sh:order 4 .
