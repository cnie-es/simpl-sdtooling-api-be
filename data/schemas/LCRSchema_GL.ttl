@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix bcp47: <http://w3id.org/meta-share/bcp47/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix continent: <http://publications.europa.eu/resource/authority/continent/> .
@prefix country: <http://publications.europa.eu/resource/authority/country/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix edval: <http://w3id.org/gaia-x/edval#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix gax-validation: <http://w3id.org/gaia-x/validation#> .
@prefix lexmeta: <http://w3id.org/meta-share/lexmeta#> .
@prefix ms: <http://w3id.org/meta-share/meta-share/> .
@prefix omtd: <http://w3id.org/meta-share/omtd-share/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix simpl: <http://w3id.org/gaia-x/simpl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gax-validation:LCROfferingShape a sh:NodeShape ;
    sh:property [ skos:example "'(un obxecto de tipo ms:LexicalConceptualResource con title, description, lrType, mediaType, lingualityType, language, etc.)'" ;
            sh:description "Metadatos do recurso léxico-conceptual conformes ao perfil LanguageDCAT-AP para a interoperabilidade co Espazo Europeo de Datos Lingüísticos. Inclúe título, descrición, tipo de recurso lingüístico, tipo de medio, lingualidade, metadatos de idioma, propiedades de cumprimento do RXPD e información de distribución." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Activo de recurso léxico-conceptual" ;
            sh:node gax-validation:LexicalConceptualResourceShape ;
            sh:order 1 ;
            sh:path edval:lcrAsset ],
        [ skos:example "'true', 'false'" ;
            sh:datatype xsd:boolean ;
            sh:description "Indica se esta oferta de recurso lingüístico é de acceso público (true) ou está restrinxida unicamente a partes autorizadas (false)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Oferta pública" ;
            sh:order 2 ;
            sh:path edval:isPublicOffering ],
        [ skos:example "'(a structure object of type DataProperties'" ;
            sh:description "Clasificación básica do servizo segundo o tipo de provisión e o modelo de servizo." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Propiedades dos datos" ;
            sh:node gax-validation:DataPropertiesShape ;
            sh:order 3 ;
            sh:path simpl:dataProperties ],
        [ skos:example "'(a structure object of type GeneralServiceProperties'" ;
            sh:description "Clasificación básica do servizo segundo o tipo de provisión e o modelo de servizo." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Propiedades xerais do servizo" ;
            sh:node gax-validation:GeneralServicePropertiesShape ;
            sh:order 4 ;
            sh:path simpl:generalServiceProperties ],
        [ skos:example "'(a structure object of type AssetProperties'" ;
            sh:description "Clasificación básica do servizo segundo o tipo de provisión e o modelo de servizo." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Propiedades do activo" ;
            sh:node gax-validation:AssetPropertiesShape ;
            sh:order 5 ;
            sh:path simpl:assetProperties ],
        [ skos:example "'(a structure object of type ProviderInformation'" ;
            sh:description "Clasificación básica do servizo segundo o tipo de provisión e o modelo de servizo." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Información do provedor" ;
            sh:node gax-validation:ProviderInformationShape ;
            sh:order 6 ;
            sh:path simpl:providerInformation ],
        [ skos:example "'(a structure object of type OfferingPrice'" ;
            sh:description "Clasificación básica do servizo segundo o tipo de provisión e o modelo de servizo." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Prezo da oferta" ;
            sh:node gax-validation:OfferingPriceShape ;
            sh:order 7 ;
            sh:path simpl:offeringPrice ],
        [ skos:example "'(a structure object of type ServicePolicy'" ;
            sh:description "Clasificación básica do servizo segundo o tipo de provisión e o modelo de servizo." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Política do servizo" ;
            sh:node gax-validation:ServicePolicyShape ;
            sh:order 8 ;
            sh:path simpl:servicePolicy ],
        [ skos:example "'(a structure object of type ContractTemplate'" ;
            sh:description "Clasificación básica do servizo segundo o tipo de provisión e o modelo de servizo." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Modelo de contrato" ;
            sh:node gax-validation:ContractTemplateShape ;
            sh:order 9 ;
            sh:path simpl:contractTemplate ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'(a structure object of type EdcRegistration'" ;
            sh:description "Clasificación básica do servizo segundo o tipo de provisión e o modelo de servizo." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Rexistro EDC" ;
            sh:node gax-validation:EdcRegistrationShape ;
            sh:order 10 ;
            sh:path simpl:edcRegistration ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'(a structure object of type EdcConnector'" ;
            sh:description "Clasificación básica do servizo segundo o tipo de provisión e o modelo de servizo." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Conector EDC" ;
            sh:node gax-validation:EdcConnectorShape ;
            sh:order 11 ;
            sh:path simpl:edcConnector ] ;
    sh:targetClass edval:LCROffering .

gax-validation:AssetPropertiesShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "requiredOnFrontendOnly" ) ;
            skos:example "'{ 'Json' : 'Object' }'" ;
            sh:datatype xsd:string ;
            sh:description "Enderezo de datos do provedor." ;
            sh:maxCount 1 ;
            sh:name "Enderezo de datos do provedor" ;
            sh:order 1 ;
            sh:path simpl:providerDataAddress ] ;
    sh:targetClass simpl:AssetProperties .

gax-validation:ContractTemplateShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'Contract Template 1', 'Contract Template 2'" ;
            sh:datatype xsd:string ;
            sh:description "Indica o documento de modelo de contrato." ;
            sh:in ( "Contract Template 1" "Contract Template 2" "Contract Template 3" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Documento de modelo de contrato" ;
            sh:order 1 ;
            sh:path simpl:contractTemplateDocument ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'Free text'" ;
            sh:datatype xsd:string ;
            sh:description "Indica o valor hash." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Valor hash do modelo de contrato" ;
            sh:order 2 ;
            sh:path simpl:contractTemplateHashValue ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'Free text'" ;
            sh:datatype xsd:string ;
            sh:description "Indica o algoritmo hash." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Algoritmo hash do modelo de contrato" ;
            sh:order 3 ;
            sh:path simpl:contractTemplateHashAlg ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'URL'" ;
            sh:datatype xsd:string ;
            sh:description "URL." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "URL do modelo de contrato" ;
            sh:order 4 ;
            sh:path simpl:contractTemplateURL ] ;
    sh:targetClass simpl:ContractTemplate .

gax-validation:DataPropertiesShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'http://provenanceURL.eu'" ;
            sh:datatype xsd:anyURI ;
            sh:description "Procedencia." ;
            sh:maxCount 1 ;
            sh:name "Producido por" ;
            sh:order 1 ;
            sh:path simpl:producedBy ;
            sh:pattern "^([Hh][Tt][Tt][Pp][Ss]?):\\/\\/(?:www\\.)?[A-Za-z0-9][-A-Za-z0-9@:%_\\+~#=\\.]{0,255}\\.[A-Za-z0-9()]{1,6}\\b(?:[-A-Za-z0-9()@:%_\\+.~#?&/=]*)$" ],
        [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'csv, xml'" ;
            sh:datatype xsd:string ;
            sh:description "Formato baixo o que se distribúen os datos (p. ex., csv, xml, …)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Formato" ;
            sh:order 2 ;
            sh:path simpl:format ;
            sh:pattern "^[a-zA-Z0-9][a-zA-Z0-9\\s]*$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'http://mysite/swagger-ui/index.html'" ;
            sh:datatype xsd:anyURI ;
            sh:description "Esquema do conxunto de datos; depende do tipo de datos: para JSON sería unha descrición JSON Schema que indica que campos teñen os datos e os seus tipos." ;
            sh:name "OpenAPI" ;
            sh:order 3 ;
            sh:path simpl:openApi ;
            sh:pattern "^([Hh][Tt][Tt][Pp][Ss]?):\\/\\/(?:www\\.)?[A-Za-z0-9][-A-Za-z0-9@:%_\\+~#=\\.]{0,255}\\.[A-Za-z0-9()]{1,6}\\b(?:[-A-Za-z0-9()@:%_\\+.~#?&/=]*)$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'http://mysite/swagger-ui/index.html'" ;
            sh:datatype xsd:anyURI ;
            sh:description "Información adicional sobre o conxunto de datos." ;
            sh:maxCount 1 ;
            sh:name "Información adicional" ;
            sh:order 4 ;
            sh:path simpl:additionalInfo ;
            sh:pattern "^([Hh][Tt][Tt][Pp][Ss]?):\\/\\/(?:www\\.)?[A-Za-z0-9][-A-Za-z0-9@:%_\\+~#=\\.]{0,255}\\.[A-Za-z0-9()]{1,6}\\b(?:[-A-Za-z0-9()@:%_\\+.~#?&/=]*)$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'Text'" ;
            sh:datatype xsd:string ;
            sh:description "Conxuntos de datos relacionados." ;
            sh:name "Conxuntos de datos relacionados" ;
            sh:order 5 ;
            sh:path simpl:relatedDatasets ;
            sh:pattern "^[a-zA-Z0-9][a-zA-Z0-9\\s]*$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'Text'" ;
            sh:datatype xsd:string ;
            sh:description "Usuarios destinatarios." ;
            sh:name "Usuarios destinatarios" ;
            sh:order 6 ;
            sh:path simpl:targetUsers ;
            sh:pattern "^[a-zA-Z0-9][a-zA-Z0-9\\s]*$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'Text'" ;
            sh:datatype xsd:string ;
            sh:description "Calidade dos datos (inclúe métricas como completitude, exactitude, actualidade e outras)." ;
            sh:name "Calidade dos datos" ;
            sh:order 7 ;
            sh:path simpl:dataQuality ;
            sh:pattern "^[a-zA-Z0-9][a-zA-Z0-9\\s]*$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'Text'" ;
            sh:datatype xsd:string ;
            sh:description "Cifrado: describe os algoritmos de cifrado e as chaves utilizadas para protexer os datos." ;
            sh:maxCount 1 ;
            sh:name "Cifrado" ;
            sh:order 8 ;
            sh:path simpl:encryption ;
            sh:pattern "^[a-zA-Z0-9][a-zA-Z0-9\\s]*$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'Text'" ;
            sh:datatype xsd:string ;
            sh:description "Anonimización/seudonimización: indica se a información sensible se anonimizou ou seudonimizou para protexer a privacidade." ;
            sh:maxCount 1 ;
            sh:name "Anonimización" ;
            sh:order 9 ;
            sh:path simpl:anonymization ;
            sh:pattern "^[a-zA-Z0-9][a-zA-Z0-9\\s]*$" ] ;
    sh:targetClass simpl:DataProperties .

gax-validation:DistributionShape a sh:NodeShape ;
    sh:property [ skos:example "'omtd:Csv', 'omtd:Json', 'omtd:Xml'" ;
            sh:description "Formato de datos da distribución: un IRI de omtd:DataFormatScheme (p. ex., omtd:Csv, omtd:Json, omtd:Xml)." ;
            sh:in ( omtd:ANNIS omtd:AclAnthologyCorpusFormat omtd:AimedCorpusFormat omtd:Alto omtd:AlvisEnrichedDocumentFormat omtd:Anafora omtd:AnnotationFormat omtd:AudioFormat omtd:Avro_json omtd:BLAST omtd:BinaryCas omtd:BinaryFormat omtd:Bionlp omtd:BionlpFormat omtd:BionlpSt2013A1_a2 omtd:Blikiwikipedia omtd:BncFormat omtd:Brat omtd:CBOR omtd:Cadixe_json omtd:Chat omtd:Cochrane omtd:Conll2000 omtd:Conll2002 omtd:Conll2003 omtd:Conll2006 omtd:Conll2008 omtd:Conll2009 omtd:Conll2012 omtd:ConllFormat omtd:ConllU omtd:CorpusFormat omtd:Csv omtd:DatabaseFormat omtd:Datasift_json omtd:Diaml omtd:DkproTokenized omtd:DocumentFormat omtd:EAF omtd:Emma omtd:FactoredTagLemFormat omtd:FastInfoset omtd:Folia omtd:GateFormat omtd:GateXml omtd:Gate_twitter_json omtd:Graf omtd:Gzip omtd:Html omtd:Html5Microdata omtd:I2b2 omtd:ImageFormat omtd:Imscwb omtd:InlineXml omtd:Jdbc omtd:Json omtd:JsonL omtd:Json_genia omtd:Kaf omtd:KeaCorpus omtd:LD_json omtd:Latex omtd:LinkedDataFormat omtd:Lll omtd:MLModelFormat omtd:MOSESFormat omtd:MalletLdaTopicProportions omtd:MalletLdaTopicProportionsSorted omtd:MediaWikiMarkup omtd:MsAccessDatabase omtd:MsExcel omtd:MsExcel_xlsx omtd:MsPowerpoint omtd:MsWord omtd:MsWord_docx omtd:Naf omtd:NegraExport omtd:Nif omtd:ONNX omtd:OasisPresentation omtd:OasisSpreadsheet omtd:OasisText omtd:Obo omtd:OpenFormat omtd:OpenOfficeDocument omtd:OpenOfficePresentation omtd:OpenOfficeSpreadsheet omtd:Owl omtd:Owl_xml omtd:PackageFormat omtd:Pdf omtd:Pls omtd:Pml omtd:Postscript omtd:Ptb omtd:PtbChunked omtd:PtbCombined omtd:Pubmed omtd:RawAudioFormat omtd:RdfFormat omtd:Rdf_xml omtd:Reuters21578Sgml omtd:Reuters21578Txt omtd:Rtf omtd:SDL_tm_xliff omtd:SQL omtd:SerializedCas omtd:Sgml omtd:Solr omtd:TFSavedModel omtd:TabularFormat omtd:Tbx omtd:Tcf omtd:Tei omtd:Tex omtd:Text omtd:TextXML omtd:Tgrep2 omtd:Tgz omtd:TigerXml omtd:Tika omtd:Tmx omtd:Tsv omtd:Tuepp omtd:Turtle omtd:UimaCasFormat omtd:Uima_json omtd:VideoFormat omtd:WARC omtd:Web1t omtd:WebAnnotationFormat omtd:WikiFormat omtd:WikipediaArticle omtd:WikipediaArticleInfo omtd:WikipediaDiscussion omtd:WikipediaFormat omtd:WikipediaLink omtd:WikipediaPage omtd:WikipediaQuery omtd:WikipediaRevision omtd:WikipediaRevisionPair omtd:WikipediaTemplateFilteredArticle omtd:Xces omtd:XcesIlspVariant omtd:Xhtml omtd:Xmi omtd:Xml omtd:XmlBioc omtd:Xpath omtd:Zip omtd:aif omtd:avi omtd:basic omtd:bmp omtd:flac omtd:gif omtd:hdf5 omtd:jpg omtd:mleap omtd:mp3 omtd:mp4 omtd:mpg omtd:octetStream omtd:other omtd:pkl omtd:pmml omtd:png omtd:protoBuf omtd:protoBuf_Json omtd:svg omtd:tar omtd:tiff omtd:unspecified omtd:wav omtd:yaml omtd:xml ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Formato" ;
            sh:order 1 ;
            sh:path dct:format ],
        [ skos:example "'omtd:Zip', 'omtd:Gzip', 'omtd:Tgz'" ;
            sh:description "Formato de empaquetado/compresión (de omtd:PackageFormatScheme)." ;
            sh:in ( omtd:Gzip omtd:Tgz omtd:Zip omtd:other omtd:tar omtd:unspecified omtd:zip ) ;
            sh:maxCount 1 ;
            sh:name "Formato de empaquetado" ;
            sh:order 2 ;
            sh:path dcat:packageFormat ],
        [ skos:example "'1048576', '524288000'" ;
            sh:datatype xsd:integer ;
            sh:description "Tamaño da distribución en bytes (debe ser positivo)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Tamaño en bytes" ;
            sh:order 3 ;
            sh:path dcat:byteSize ],
        [ skos:example "'(un obxecto de tipo SizeWithUnit con amount e sizeUnit)'" ;
            sh:description "Tamaño lexible coa súa unidade." ;
            sh:minCount 1 ;
            sh:name "Tamaño" ;
            sh:node gax-validation:SizeShape ;
            sh:order 4 ;
            sh:path ms:size ] ;
    sh:targetClass dcat:Distribution .

gax-validation:DocumentDocumentationGroup a sh:PropertyGroup ;
    rdfs:label "Documentación" ;
    sh:order 1 .

gax-validation:DocumentShape a sh:NodeShape ;
    sh:property [ skos:example "'Smith, J. et al. (2023). Spanish Legal Corpus v1.0. Journal of Language Resources.'" ;
            sh:datatype rdf:langString ;
            sh:description "Cita en texto libre da documentación." ;
            sh:group gax-validation:DocumentDocumentationGroup ;
            sh:minCount 1 ;
            sh:name "Texto da cita" ;
            sh:order 1 ;
            sh:path ms:citationText ] ;
    sh:targetClass foaf:Document .

gax-validation:EdcConnectorShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'providerEndpointURL'" ;
            sh:datatype xsd:string ;
            sh:description "URL do endpoint do provedor." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "URL do endpoint do provedor" ;
            sh:order 1 ;
            sh:path simpl:providerEndpointURL ] ;
    sh:targetClass simpl:EdcConnector .

gax-validation:EdcRegistrationShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'Identifier'" ;
            sh:datatype xsd:string ;
            sh:description "Identificador único da definición de contrato." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Id de definición de contrato" ;
            sh:order 1 ;
            sh:path simpl:contractDefinitionId ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'Identifier'" ;
            sh:datatype xsd:string ;
            sh:description "Identificador único da política do servizo." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Id de política do servizo" ;
            sh:order 2 ;
            sh:path simpl:servicePolicyId ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'Identifier'" ;
            sh:datatype xsd:string ;
            sh:description "Identificador único da política de acceso." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Id de política de acceso" ;
            sh:order 3 ;
            sh:path simpl:accessPolicyId ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'Identifier'" ;
            sh:datatype xsd:string ;
            sh:description "Identificador único do activo." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Id do activo" ;
            sh:order 4 ;
            sh:path simpl:assetId ] ;
    sh:targetClass simpl:EdcRegistration .

gax-validation:GeneralServicePropertiesShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'Title'" ;
            sh:datatype xsd:string ;
            sh:description "Título breve do conxunto de datos/aplicación/infraestrutura." ;
            sh:maxCount 1 ;
            sh:maxLength 255 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "Nome" ;
            sh:order 1 ;
            sh:path simpl:name ;
            sh:pattern "^(.|\\s)*[a-zA-Z]+(.|\\s)*$" ],
        [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'Description'" ;
            sh:datatype xsd:string ;
            sh:description "Descrición do conxunto de datos/aplicación/infraestrutura." ;
            sh:maxCount 1 ;
            sh:maxLength 1000 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "Descrición" ;
            sh:order 2 ;
            sh:path simpl:description ;
            sh:pattern "^(.|\\s)*[a-zA-Z]+(.|\\s)*$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'URL, handle'" ;
            sh:datatype xsd:anyURI ;
            sh:description "Localización onde se pode atopar o conxunto de datos/aplicación/infraestrutura (probablemente unha URL de endpoint)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Punto de acceso ao servizo" ;
            sh:order 3 ;
            sh:path simpl:serviceAccessPoint ;
            sh:pattern "^([Hh][Tt][Tt][Pp][Ss]?):\\/\\/(?:www\\.)?[A-Za-z0-9][-A-Za-z0-9@:%_\\+~#=\\.]{0,255}\\.[A-Za-z0-9()]{1,6}\\b(?:[-A-Za-z0-9()@:%_\\+.~#?&/=]*)$" ],
        [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'Keywords'" ;
            sh:datatype xsd:string ;
            sh:description "Palabras clave." ;
            sh:maxCount 16 ;
            sh:maxLength 50 ;
            sh:minLength 1 ;
            sh:name "Palabras clave" ;
            sh:order 4 ;
            sh:path simpl:keywords ;
            sh:pattern "^(.|\\s)*[a-zA-Z]+(.|\\s)*$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'EN, IT'" ;
            sh:datatype xsd:string ;
            sh:description "Idioma (dos metadatos, como o título ou a descrición)." ;
            sh:in ( "es" "gl" "ca" "eu" "en" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Idioma" ;
            sh:order 5 ;
            sh:path simpl:inLanguage ],
        [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'application, data, infrastructure'" ;
            sh:datatype xsd:string ;
            sh:description "Tipo de oferta utilizado para a busca." ;
            sh:in ( "application" "data" "infrastructure" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Tipo de oferta" ;
            sh:order 6 ;
            sh:path simpl:offeringType ],
        [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'Id'" ;
            sh:datatype xsd:string ;
            sh:description "Id do método de compartición utilizado para o modelo de enderezo do recurso." ;
            sh:maxCount 1 ;
            sh:name "Id do método de compartición" ;
            sh:order 7 ;
            sh:path simpl:sharingMethodId ] ;
    sh:targetClass simpl:GeneralServiceProperties .

gax-validation:LexicalConceptualResourceDistributionGroup a sh:PropertyGroup ;
    rdfs:label "Distribución" ;
    sh:order 5 .

gax-validation:LexicalConceptualResourceDocumentationGroup a sh:PropertyGroup ;
    rdfs:label "Documentación" ;
    sh:order 14 .

gax-validation:LexicalConceptualResourceIntellectualPropertyRightsGroup a sh:PropertyGroup ;
    rdfs:label "Titular de dereitos" ;
    sh:order 9 .

gax-validation:LexicalConceptualResourceLanguageGroup a sh:PropertyGroup ;
    rdfs:label "Idioma" ;
    sh:order 3 .

gax-validation:LexicalConceptualResourceLicenseGroup a sh:PropertyGroup ;
    rdfs:label "Licenza" ;
    sh:order 7 .

gax-validation:LexicalConceptualResourceMetalanguageGroup a sh:PropertyGroup ;
    rdfs:label "Metalengua" ;
    sh:order 13 .

gax-validation:LexicalConceptualResourcePivotLanguageGroup a sh:PropertyGroup ;
    rdfs:label "Idioma pivote" ;
    sh:order 12 .

gax-validation:LexicalConceptualResourcePublisherGroup a sh:PropertyGroup ;
    rdfs:label "Editor" ;
    sh:order 8 .

gax-validation:LexicalConceptualResourceShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'ms:lexicalConceptualResource1'" ;
            sh:description "IRI do tipo de recurso lingüístico (de ms:LRTypeTaxonomy)." ;
            sh:in ( ms:lexicalConceptualResource1 ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Tipo de recurso lingüístico" ;
            sh:order 1 ;
            sh:path ms:lrType ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'Corpus Legal Español'" ;
            sh:datatype rdf:langString ;
            sh:description "Título lexible do recurso lingüístico" ;
            sh:group gax-validation:LexicalConceptualResourceBasicInformationGroup ;
            sh:minCount 1 ;
            sh:name "Título" ;
            sh:order 2 ;
            sh:path dct:title ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'Un corpus de documentos legales de tribunales españoles anotado con entidades nombradas'" ;
            sh:datatype rdf:langString ;
            sh:description "Descrición lexible do contido e o propósito do recurso." ;
            sh:group gax-validation:LexicalConceptualResourceBasicInformationGroup ;
            sh:minCount 1 ;
            sh:name "Descrición" ;
            sh:order 3 ;
            sh:path dct:description ],
        [ skos:example "'1.0', '2.1.3'" ;
            sh:datatype xsd:string ;
            sh:description "Identificador de versión da publicación do recurso." ;
            sh:group gax-validation:LexicalConceptualResourceBasicInformationGroup ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Versión" ;
            sh:order 4 ;
            sh:path dcat:version ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'corpus', 'legal', 'español', 'NER'" ;
            sh:datatype rdf:langString ;
            sh:description "Palabras clave que describen o contido e o dominio do recurso." ;
            sh:group gax-validation:LexicalConceptualResourceBasicInformationGroup ;
            sh:maxCount 10 ;
            sh:minCount 1 ;
            sh:name "Palabra clave" ;
            sh:order 5 ;
            sh:path dcat:keyword ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'ms:text', 'ms:audio', 'ms:video'" ;
            sh:description "Tipo de medio do contido do recurso (de ms:MediaTypeTaxonomy)." ;
            sh:group gax-validation:LexicalConceptualResourceBasicInformationGroup ;
            sh:in ( ms:audio ms:image ms:text ms:textNumerical ms:video ) ;
            sh:minCount 1 ;
            sh:name "Tipo de medio" ;
            sh:order 6 ;
            sh:path ms:mediaType ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'ms:monolingual', 'ms:bilingual', 'ms:multilingual'" ;
            sh:description "Indica se o recurso é monolingüe, bilingüe ou multilingüe (de ms:LingualityTypeTaxonomy)." ;
            sh:group gax-validation:LexicalConceptualResourceBasicInformationGroup ;
            sh:in ( ms:bilingual ms:bilingualized ms:monolingual ms:multilingual ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Tipo de lingualidade" ;
            sh:order 7 ;
            sh:path ms:lingualityType ],
        [ skos:example "'ES-Legal-Corpus'" ;
            sh:datatype rdf:langString ;
            sh:description "Título alternativo ou acrónimo do recurso." ;
            sh:group gax-validation:LexicalConceptualResourceIdentificationGroup ;
            sh:name "Título alternativo" ;
            sh:order 8 ;
            sh:path dct:alternative ],
        [ skos:example "'(un obxecto de tipo adms:Identifier con skos:notation e adms:schemaAgency)'" ;
            sh:description "Identificador(es) ADMS do recurso (p. ex., DOI, Handle, ISNI, ROR)." ;
            sh:group gax-validation:LexicalConceptualResourceIdentificationGroup ;
            sh:name "Identificador" ;
            sh:node gax-validation:IdentifierShape ;
            sh:order 9 ;
            sh:path adms:identifier ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "" ;
            sh:description "Metadatos de idioma (meta-share) que especifican a(s) lingua(s) representada(s) no recurso léxico-conceptual (de ms:LanguageTaxonomy). Pódense especificar varias linguas para recursos multilingües." ;
            sh:group gax-validation:LexicalConceptualResourceLanguageGroup ;
            sh:minCount 1 ;
            sh:name "Idioma" ;
            sh:node gax-validation:LanguageShape ;
            sh:order 10 ;
            sh:path ms:language ],
        [ skos:example "'ms:yesA', 'ms:noA', 'ms:unknownA'" ;
            sh:description "Indica se o recurso foi anonimizado (de ms:AnonymizedTaxonomy)." ;
            sh:group gax-validation:LexicalConceptualResourceDataProtectionGroup ;
            sh:in ( ms:noA ms:unknownA ms:yesA ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Anonimizado" ;
            sh:order 11 ;
            sh:path ms:anonymized ],
        [ skos:example "'ms:yesP', 'ms:noP', 'ms:unknownP'" ;
            sh:description "Indica se o recurso contén datos persoais segundo o RXPD (de ms:PersonalDataIncludedTaxonomy). Obrigatorio para o cumprimento do RXPD. Non pode establecerse se anonymized é yesA." ;
            sh:group gax-validation:LexicalConceptualResourceDataProtectionGroup ;
            sh:in ( ms:noP ms:unknownP ms:yesP ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Inclúe datos persoais" ;
            sh:order 12 ;
            sh:path ms:personalDataIncluded ],
        [ skos:example "'dpv:Encryption', 'dpv:Pseudonymisation', 'dpv:AccessControlPolicy'" ;
            sh:description "Medida técnica ou organizativa aplicada para protexer os datos persoais (de ms:TechnicalOrganisationalMeasureTaxonomy). Obrigatoria cando personalDataIncluded é yesP." ;
            sh:group gax-validation:LexicalConceptualResourceDataProtectionGroup ;
            sh:in ( ms:accessControlsAuthenticationMechanisms ms:dataBackupAndRecoveryProcedures ms:dataBreachNotificationMechanisms ms:dataRetentionAndDeletionPolicies ms:encryptionOfPersonalData ms:incidentResponseAndManagementProcedures ms:networkAndCommunicationSecurity ms:physicalSecurityMeasuresForPremisesAndEquipment ms:pseudonymisationOfPersonalData ms:staffTrainingOnDataProtectionAndSecurityAwareness ) ;
            sh:name "Medida técnica ou organizativa" ;
            sh:order 13 ;
            sh:path dpv:hasTechnicalOrganisationalMeasure ],
        [ skos:example "'Nombres y ubicaciones reemplazados con marcadores de posición utilizando spaCy NER'" ;
            sh:datatype rdf:langString ;
            sh:description "Descrición libre do proceso de anonimización aplicado ao recurso." ;
            sh:group gax-validation:LexicalConceptualResourceDataProtectionGroup ;
            sh:name "Detalles de anonimización" ;
            sh:order 14 ;
            sh:path ms:anonymizationDetails ],
        [ skos:example "'ms:yesS', 'ms:noS', 'ms:unknownS'" ;
            sh:description "Indica se o recurso contén datos sensibles (de ms:SensitiveDataIncludedTaxonomy). Obrigatorio para o cumprimento do RXPD. Non pode establecerse se anonymized é yesA." ;
            sh:group gax-validation:LexicalConceptualResourceDataProtectionGroup ;
            sh:in ( ms:noS ms:unknownS ms:yesS ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Inclúe datos sensibles" ;
            sh:order 15 ;
            sh:path ms:sensitiveDataIncluded ],
        [ skos:example "'Contiene registros de diagnósticos médicos'" ;
            sh:datatype rdf:langString ;
            sh:description "Descrición libre dos datos sensibles contidos no recurso." ;
            sh:group gax-validation:LexicalConceptualResourceDataProtectionGroup ;
            sh:name "Detalles de datos sensibles" ;
            sh:order 16 ;
            sh:path ms:sensitiveDataDetails ],
        [ skos:example "'Contiene nombres de textos biográficos anotados'" ;
            sh:datatype rdf:langString ;
            sh:description "Descrición libre dos datos persoais contidos no recurso." ;
            sh:group gax-validation:LexicalConceptualResourceDataProtectionGroup ;
            sh:name "Detalles de datos persoais" ;
            sh:order 17 ;
            sh:path ms:personalDataDetails ],
        [ skos:example "'ms:dataPurposeLimitation', 'ms:dataMinimisation'" ;
            sh:description "Principio de protección de datos aplicado ao recurso (de ms:DataProtectionPrincipleTaxonomy). Obrigatorio cando personalDataIncluded é yesP." ;
            sh:group gax-validation:LexicalConceptualResourceDataProtectionGroup ;
            sh:in ( ms:accuracy ms:alignmentDataRights ms:dataMinimisation ms:integrityConfidentiality ms:lawfulnessFairnessTransparency ms:purposeLimitation ms:storageLimitation ) ;
            sh:name "Principio de protección de datos aplicado" ;
            sh:order 18 ;
            sh:path ms:dataProtectionPrincipleApplied ],
        [ skos:example "'Compilado a partir de reseñas de usuarios de booking.com recopiladas en 2018'" ;
            sh:datatype rdf:langString ;
            sh:description "Descrición libre da fonte orixinal da que se derivou o recurso." ;
            sh:group gax-validation:LexicalConceptualResourceDataProtectionGroup ;
            sh:name "Descrición da fonte orixinal" ;
            sh:order 19 ;
            sh:path ms:originalSourceDescription ],
        [ skos:example "'(un obxecto de tipo dcat:Distribution con título, descrición, formato, accessURL, etc.)'" ;
            sh:description "Distribución(s) do recurso léxico-conceptual, é dicir, os formatos dispoñibles e as URL de acceso." ;
            sh:group gax-validation:LexicalConceptualResourceDistributionGroup ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Distribución" ;
            sh:node gax-validation:DistributionShape ;
            sh:order 20 ;
            sh:path dcat:distribution ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'ms:wordNet', 'ms:terminologicalResource', 'ms:machineReadableDictionary'" ;
            sh:description "Subclase do recurso léxico-conceptual segundo a ms:LCRSubclassTaxonomy." ;
            sh:group gax-validation:LexicalConceptualResourceClassificationGroup ;
            sh:in ( ms:annotationScheme ms:cognates ms:computationalLexicon ms:dictionary ms:frameNet ms:knowledgeGraph ms:lexicon ms:machineReadableDictionary ms:mappingOfResources ms:morphologicalLexicon ms:ontology ms:other ms:tagset1 ms:terminologicalResource ms:thesaurus ms:typesystem1 ms:unspecified ms:wordNet ms:wordlist ) ;
            sh:maxCount 1 ;
            sh:name "Subclase de recurso léxico-conceptual" ;
            sh:order 21 ;
            sh:path ms:lcrSubclass ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'lexmeta:MicrostructureFeatureScheme', 'lexmeta:accentuation', 'lexmeta:analyticalDefinition', 'lexmeta:antedating', 'lexmeta:antonym', 'lexmeta:argumentStructure', 'lexmeta:aspect', 'lexmeta:audioContent', 'lexmeta:auxiliary', 'lexmeta:calque', 'lexmeta:case', 'lexmeta:citation', 'lexmeta:classificatoryLabel', 'lexmeta:collocation', 'lexmeta:collocator', 'lexmeta:colloquial', 'lexmeta:competenceExample', 'lexmeta:compoundWord', 'lexmeta:connotation', 'lexmeta:context', 'lexmeta:coocurrent', 'lexmeta:countability', 'lexmeta:crossReference', 'lexmeta:definingVocabulary', 'lexmeta:definition', 'lexmeta:degree', 'lexmeta:denotation', 'lexmeta:derivation', 'lexmeta:derivative', 'lexmeta:designatum', 'lexmeta:diacritic', 'lexmeta:dialect', 'lexmeta:dialectLabel', 'lexmeta:differentia', 'lexmeta:directSense', 'lexmeta:domainIndication', 'lexmeta:encyclopedicDefinition', 'lexmeta:entryBlock', 'lexmeta:entryLayoutFeature', 'lexmeta:entryLine', 'lexmeta:etymologicalInformation', 'lexmeta:etymology', 'lexmeta:eventType', 'lexmeta:example', 'lexmeta:exampleSentence', 'lexmeta:fieldLabel', 'lexmeta:figurative', 'lexmeta:fixedExpression', 'lexmeta:formalInformation', 'lexmeta:formulaicDefinition', 'lexmeta:frequency', 'lexmeta:gender', 'lexmeta:geography', 'lexmeta:gloss', 'lexmeta:hyperonym', 'lexmeta:hyphenation', 'lexmeta:hyponym', 'lexmeta:idiom', 'lexmeta:illustration', 'lexmeta:inflection', 'lexmeta:inflectionMorphology', 'lexmeta:inkhornTerm', 'lexmeta:intentionalDefinition', 'lexmeta:irregularForm', 'lexmeta:label', 'lexmeta:lemma', 'lexmeta:lexicographicDefinition', 'lexmeta:loanword', 'lexmeta:logicalDefinition', 'lexmeta:meaningDiscrimination', 'lexmeta:meronym', 'lexmeta:mood', 'lexmeta:morphologicalInformation', 'lexmeta:multimedia', 'lexmeta:nesting', 'lexmeta:number', 'lexmeta:orthography', 'lexmeta:ostensiveDefinition', 'lexmeta:partOfSpeech', 'lexmeta:person', 'lexmeta:phoneticInformation', 'lexmeta:phoneticTranscription', 'lexmeta:phra