            sh:description "Tipo de información lingüística proporcionada polo recurso segundo a taxonomía lexmeta:MicrostructureFeatureScheme." ;
            sh:group gax-validation:LexicalConceptualResourceClassificationGroup ;
            sh:in ( lexmeta:accentuation lexmeta:analyticalDefinition lexmeta:antedating lexmeta:antonym lexmeta:argumentStructure lexmeta:aspect lexmeta:audioContent lexmeta:auxiliary lexmeta:calque lexmeta:case lexmeta:citation lexmeta:classificatoryLabel lexmeta:collocation lexmeta:collocator lexmeta:colloquial lexmeta:competenceExample lexmeta:compoundWord lexmeta:connotation lexmeta:context lexmeta:coocurrent lexmeta:countability lexmeta:crossReference lexmeta:definingVocabulary lexmeta:definition lexmeta:degree lexmeta:denotation lexmeta:derivation lexmeta:derivative lexmeta:designatum lexmeta:diacritic lexmeta:dialect lexmeta:dialectLabel lexmeta:differentia lexmeta:directSense lexmeta:domainIndication lexmeta:encyclopedicDefinition lexmeta:entryBlock lexmeta:entryLayoutFeature lexmeta:entryLine lexmeta:etymologicalInformation lexmeta:etymology lexmeta:eventType lexmeta:example lexmeta:exampleSentence lexmeta:fieldLabel lexmeta:figurative lexmeta:fixedExpression lexmeta:formalInformation lexmeta:formulaicDefinition lexmeta:frequency lexmeta:gender lexmeta:geography lexmeta:gloss lexmeta:hyperonym lexmeta:hyphenation lexmeta:hyponym lexmeta:idiom lexmeta:illustration lexmeta:inflection lexmeta:inflectionMorphology lexmeta:inkhornTerm lexmeta:intentionalDefinition lexmeta:irregularForm lexmeta:label lexmeta:lemma lexmeta:lexicographicDefinition lexmeta:loanword lexmeta:logicalDefinition lexmeta:meaningDiscrimination lexmeta:meronym lexmeta:mood lexmeta:morphologicalInformation lexmeta:multimedia lexmeta:nesting lexmeta:number lexmeta:orthography lexmeta:ostensiveDefinition lexmeta:partOfSpeech lexmeta:person lexmeta:phoneticInformation lexmeta:phoneticTranscription lexmeta:phraseme lexmeta:phraseologicalInformation lexmeta:phraseology lexmeta:polysemyIndication lexmeta:pragmaticInformation lexmeta:pronunciation lexmeta:proverb lexmeta:qualiaStructure lexmeta:quotation lexmeta:reflexivity lexmeta:register lexmeta:registerLabel lexmeta:respelledPronunciation lexmeta:rootWord lexmeta:ruleBasedDefinition lexmeta:runOn lexmeta:semanticClass lexmeta:semanticFeature lexmeta:semanticField lexmeta:semanticInformation lexmeta:semanticRelation lexmeta:semanticRole lexmeta:senseOrdering lexmeta:signpost lexmeta:slang lexmeta:specializedSense lexmeta:spelling lexmeta:spellingVariant lexmeta:standardSpelling lexmeta:statusLabel lexmeta:style lexmeta:styleLabel lexmeta:subcategorizationFrame lexmeta:subentry lexmeta:subjectLabel lexmeta:subsense lexmeta:syllabification lexmeta:synonym lexmeta:syntacticInformation lexmeta:syntacticoSemanticInformation lexmeta:syntacticoSemanticLink lexmeta:syntagmaticInformation lexmeta:syntheticDefinition lexmeta:tense lexmeta:transcriptionWithInternationalPhoneticAlphabet lexmeta:translationEquivalent lexmeta:translationInformation lexmeta:troponym lexmeta:typifyingDefinition lexmeta:usageInformation lexmeta:usageLabel lexmeta:usageNote lexmeta:valency lexmeta:variant lexmeta:verbalIllustration lexmeta:videoContent lexmeta:voice lexmeta:wordCombination lexmeta:wordDivision lexmeta:wordFormation lexmeta:wordSense ) ;
            sh:name "Información lingüística" ;
            sh:order 22 ;
            sh:path ms:linguisticInformation ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'ms:parallel', 'ms:comparable'" ;
            sh:description "Tipo de multilingüismo cando lingualityType é multilingüe (de ms:MultilingualityTypeTaxonomy)." ;
            sh:group gax-validation:LexicalConceptualResourceClassificationGroup ;
            sh:in ( ms:comparable ms:multilingualSingleText ms:other ms:parallel ms:unspecified ) ;
            sh:maxCount 1 ;
