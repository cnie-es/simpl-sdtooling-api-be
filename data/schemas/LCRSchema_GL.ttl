ry:XXG country:XXH country:XXI country:XXJ country:XXL country:XXM country:XXN country:XXO country:XXP country:XXR country:XXS country:XXT country:XXU country:XXV country:XXW country:XXY country:XXZ country:YEM country:YMD country:YUG country:ZAF country:ZAR country:ZMB country:ZR0 country:ZWE ) ;
            sh:name "Cobertura espacial" ;
            sh:order 24 ;
            sh:path dct:spatial ],
        [ skos:example "'(un obxecto de tipo dct:PeriodOfTime con startDate e endDate)'" ;
            sh:description "Cobertura temporal do recurso léxico-conceptual como un dct:PeriodOfTime con datas de inicio e fin." ;
            sh:group gax-validation:LexicalConceptualResourceClassificationGroup ;
            sh:name "Cobertura temporal" ;
            sh:node gax-validation:PeriodOfTimeShape ;
            sh:order 25 ;
            sh:path dct:temporal ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'ms:law', 'ms:medicine', 'ms:science'" ;
            sh:description "Dominio ou campo que abrangue o recurso (de ms:DomainTaxonomy)." ;
            sh:group gax-validation:LexicalConceptualResourceClassificationGroup ;
            sh:in ( ms:AgricultureAndFisheries ms:EconomyAndFinancialMarkets_Services ms:EnvironmentEnergyAndSustainability ms:HealthAndWellbeing ms:ICTInfrastructure ms:Industry ms:LearningAndEducation ms:MediaCommunicationWebAndEntertainment ms:MobilityAndTransportation ms:PublicSectorAndCitizenServices ms:SafetyAndSecurity ms:ScientificResearchDesignAndEngineering ms:other ms:unspecified ) ;
            sh:name "Dominio" ;
            sh:order 26 ;
            sh:path ms:domain ],
        [ skos:example "'ms:TEI', 'ms:ISO24622', 'ms:CLARIN'" ;
            sh:description "Estándar ou boa práctica coa que cumpre o corpus (de ms:StandardBestPracticeTaxonomy)." ;
            sh:group gax-validation:LexicalConceptualResourceClassificationGroup ;
            sh:in ( ms:BML ms:CES ms:CLARIN-SHARE ms:EAGLES ms:ELG-SHARE ms:EML ms:EMMA ms:GMX ms:GrAF ms:HamNoSys ms:ISO12620 ms:ISO16642 ms:ISO1987 ms:ISO26162 ms:ISO30042 ms:ISO704 ms:InkML ms:LAF ms:LMF ms:LemonOntolex ms:MAF ms:MLIF ms:MMI ms:MULTEXT ms:MUMIN ms:OAXAL ms:SRX ms:SemAF ms:SemAF-DA ms:SemAF-DS ms:SemAF-NE ms:SemAF-SR ms:SynAF ms:TBX ms:TEI ms:TEI_P3 ms:TEI_P4 ms:TEI_P5 ms:TMX ms:TimeML ms:XCES ms:XLIFF ms:other ms:pennTreeBank ms:pragueTreebank ms:unspecified ms:wordNet ) ;
            sh:name "Conforme a" ;
            sh:order 27 ;
            sh:path dct:conformsTo ],
        [ skos:example "'(un obxecto de tipo dct:LicenseDocument)'" ;
            sh:description "Licenza(s) baixo a(s) que se pon a disposición o recurso léxico-conceptual (dct:license)." ;
            sh:group gax-validation:LexicalConceptualResourceLicenseGroup ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Licenza" ;
            sh:node gax-validation:LicenseDocumentShape ;
            sh:order 28 ;
            sh:path dct:license ],
        [ skos:example "'(un obxecto de tipo foaf:Organization)'" ;
            sh:description "Organización que publica ou pon a disposición o recurso léxico-conceptual (dct:publisher)." ;
            sh:group gax-validation:LexicalConceptualResourcePublisherGroup ;
            sh:maxCount 1 ;
            sh:name "Editor" ;
            sh:node gax-validation:OrganizationShape ;
            sh:order 29 ;
            sh:path dct:publisher ],
        [ skos:example "'(un obxecto de tipo foaf:Organization)'" ;
            sh:description "Titular(es) dos dereitos de propiedade intelectual do recurso léxico-conceptual (LanguageDCAT-AP ms:iprHolder)." ;
            sh:group gax-validation:LexicalConceptualResourceIntellectualPropertyRightsGroup ;
            sh:name "Titular de dereitos" ;
            sh:node gax-validation:OrganizationShape ;
            sh:order 30 ;
            sh:path ms:iprHolder ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "" ;
            sh:description "Lingua(s) de orixe dun recurso léxico-conceptual paralelo/multilingüe (LanguageDCAT-AP ms:sourceLanguage)." ;
            sh:group gax-validation:LexicalConceptualResourceSourceLanguageGroup ;
            sh:name "Lingua de orixe" ;
            sh:node gax-validation:LanguageShape ;
            sh:order 31 ;
            sh:path ms:sourceLanguage ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "" ;
            sh:description "Lingua(s) de destino dun recurso léxico-conceptual paralelo/multilingüe (LanguageDCAT-AP ms:targetLanguage)." ;
            sh:group gax-validation:LexicalConceptualResourceTargetLanguageGroup ;
            sh:name "Lingua de destino" ;
            sh:node gax-validation:LanguageShape ;
            sh:order 32 ;
            sh:path ms:targetLanguage ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "" ;
            sh:description "Lingua(s) pivote utilizada(s) como representación intermedia nun recurso léxico-conceptual paralelo/multilingüe (LanguageDCAT-AP ms:pivotLanguage)." ;
            sh:group gax-validation:LexicalConceptualResourcePivotLanguageGroup ;
            sh:name "Lingua pivote" ;
            sh:node gax-validation:LanguageShape ;
            sh:order 33 ;
            sh:path ms:pivotLanguage ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "" ;
            sh:description "Lingua(s) utilizada(s) para describir, anotar ou definir as entradas do recurso léxico-conceptual (LanguageDCAT-AP ms:metalanguage)." ;
            sh:group gax-validation:LexicalConceptualResourceMetalanguageGroup ;
            sh:name "Metalingua" ;
            sh:node gax-validation:LanguageShape ;
            sh:order 34 ;
            sh:path ms:metalanguage ],
        [ skos:example "" ;
            sh:description "Liga un recurso léxico-conceptual cun documento (p. ex., un artigo de investigación que describe o seu contido ou o seu uso nun proxecto, un manual de usuario, etc.) ou calquera outra forma de documentación (p. ex., unha URL con información de soporte) relacionada co recurso." ;
            sh:group gax-validation:LexicalConceptualResourceDocumentationGroup ;
            sh:name "Documentado por" ;
            sh:node gax-validation:DocumentShape ;
            sh:order 35 ;
            sh:path ms:isDocumentedBy ] ;
    sh:targetClass ms:LexicalConceptualResource .

gax-validation:LexicalConceptualResourceSourceLanguageGroup a sh:PropertyGroup ;
    rdfs:label "Idioma de orixe" ;
    sh:order 10 .

gax-validation:LexicalConceptualResourceTargetLanguageGroup a sh:PropertyGroup ;
    rdfs:label "Idioma de destino" ;
    sh:order 11 .

gax-validation:LicenseDocumentShape a sh:NodeShape ;
    sh:property [ skos:example "'Creative Commons Attribution 4.0 International'" ;
            sh:datatype rdf:langString ;
            sh:description "Título lexible da licenza" ;
            sh:minCount 1 ;
            sh:name "Título" ;
            sh:order 1 ;
            sh:path dct:title ],
        [ skos:example "'Permite compartir y adaptar con atribución.'" ;
            sh:datatype rdf:langString ;
            sh:description "Descrición lexible da licenza" ;
            sh:minCount 1 ;
            sh:name "Descrición" ;
            sh:order 2 ;
            sh:path dct:description ],
        [ skos:example "'https://creativecommons.org/licenses/by/4.0/legalcode'" ;
            sh:datatype xsd:anyURI ;
            sh:description "IRI do código legal/texto completo da licenza (cc:legalcode)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Código legal" ;
            sh:order 3 ;
            sh:path cc:legalcode ;
            sh:pattern "^([Hh][Tt][Tt][Pp][Ss]?):\\/\\/(?:www\\.)?[A-Za-z0-9][-A-Za-z0-9@:%_\\+~#=\\.]{0,255}\\.[A-Za-z0-9()]{1,6}\\b(?:[-A-Za-z0-9()@:%_\\+.~#?&/=]*)$" ],
        [ skos:example "'(un obxecto de tipo adms:Identifier con skos:notation e adms:schemaAgency)'" ;
            sh:description "Identificador(es) ADMS do documento de licenza." ;
            sh:name "Identificador" ;
            sh:node gax-validation:IdentifierShape ;
            sh:order 4 ;
            sh:path adms:identifier ] ;
    sh:targetClass dct:LicenseDocument .

gax-validation:OfferingPriceShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'www.simpl.com'" ;
            sh:datatype xsd:anyURI ;
            sh:description "URL da licenza utilizada." ;
            sh:maxLength 255 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "Licenza" ;
            sh:order 1 ;
            sh:path simpl:license ;
            sh:pattern "^([Hh][Tt][Tt][Pp][Ss]?):\\/\\/(?:www\\.)?[A-Za-z0-9][-A-Za-z0-9@:%_\\+~#=\\.]{0,255}\\.[A-Za-z0-9()]{1,6}\\b(?:[-A-Za-z0-9()@:%_\\+.~#?&/=]*)$" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'BGN, EUR, CZK'" ;
            sh:datatype xsd:string ;
            sh:description "Moeda do prezo." ;
            sh:in ( "BGN" "EUR" "CZK" "DKK" "HUF" "PLN" "RON" "SEK" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Moeda" ;
            sh:order 2 ;
            sh:path simpl:currency ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'0, 1, 2'" ;
            sh:datatype xsd:decimal ;
            sh:description "Prezo e condicións." ;
            sh:maxCount 1 ;
            sh:maxInclusive 99999999999.0 ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:name "Prezo" ;
            sh:order 3 ;
            sh:path simpl:price ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'free, commercial'" ;
            sh:datatype xsd:string ;
            sh:description "Tipo de prezo." ;
            sh:in ( "free" "commercial" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Tipo de prezo" ;
            sh:order 4 ;
            sh:path simpl:priceType ] ;
    sh:targetClass simpl:OfferingPrice .

gax-validation:PeriodOfTimeShape a sh:NodeShape ;
    sh:property [ skos:example "'2018-01-01'" ;
            sh:datatype xsd:date ;
            sh:description "Data de inicio do período (inclusive)." ;
            sh:maxCount 1 ;
            sh:name "Data de inicio" ;
            sh:order 1 ;
            sh:path dcat:startDate ],
        [ skos:example "'2018-12-31'" ;
            sh:datatype xsd:date ;
            sh:description "Data de fin do período (inclusive)." ;
            sh:maxCount 1 ;
            sh:name "Data de fin" ;
            sh:order 2 ;
            sh:path dcat:endDate ] ;
    sh:targetClass dct:PeriodOfTime .

gax-validation:ProviderInformationShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "hiddenInFrontend" ) ;
            skos:example "'123'" ;
            sh:datatype xsd:string ;
            sh:description "Referencia ao ID do provedor do conxunto de datos/aplicación/infraestrutura." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Proporcionado por" ;
            sh:order 1 ;
            sh:path simpl:providedBy ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'support'" ;
            sh:datatype xsd:string ;
            sh:description "A quen contactar en caso de preguntas ou incidencias." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Contacto" ;
            sh:order 2 ;
            sh:path simpl:contact ;
            sh:pattern "^[\\w\\-\\.]+@([\\w-]+\\.)+[\\w-]{2,4}$" ],
        [ simpl:configure ( "hiddenInFrontend" "useForAdvancedSearch" ) ;
            skos:example "'signature'" ;
            sh:datatype xsd:string ;
            sh:description "Sinatura dixital que garante que o provedor é quen subiu a autodescrición." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Sinatura" ;
            sh:order 3 ;
            sh:path simpl:signature ;
            sh:pattern "^[a-zA-Z0-9][a-zA-Z0-9\\s-]*$" ] ;
    sh:targetClass simpl:ProviderInformation .

gax-validation:ServicePolicyShape a sh:NodeShape ;
    sh:property [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'ODRL policy'" ;
            sh:datatype xsd:string ;
            sh:description "Política de acceso que define quen pode acceder ao conxunto de datos." ;
            sh:minCount 1 ;
            sh:name "Política de acceso" ;
            sh:order 1 ;
            sh:path simpl:access-policy ;
            sh:pattern "[:,\\{\\}\\[\\]]|(\".*?\")|('.*?')|[-\\w.]+" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'ODRL policy'" ;
            sh:datatype xsd:string ;
            sh:description "Política de uso que define como se pode utilizar un conxunto de datos." ;
            sh:minCount 1 ;
            sh:name "Política de uso" ;
            sh:order 2 ;
            sh:path simpl:usage-policy ;
            sh:pattern "[:,\\{\\}\\[\\]]|(\".*?\")|('.*?')|[-\\w.]+" ],
        [ simpl:configure ( "useForAdvancedSearch" ) ;
            skos:example "'Free text'" ;
            sh:datatype xsd:string ;
            sh:description "Indica o cumprimento das normativas e estándares de protección de datos pertinentes." ;
            sh:name "Réxime de protección de datos" ;
            sh:order 3 ;
            sh:path simpl:dataProtectionRegime ;
            sh:pattern "[:,\\{\\}\\[\\]]|(\".*?\")|('.*?')|[-\\w.]+" ] ;
    sh:targetClass simpl:ServicePolicy .

gax-validation:SizeShape a sh:NodeShape ;
    sh:property [ skos:example "'1000000', '5432'" ;
            sh:datatype xsd:float ;
            sh:description "Cantidade numérica (debe ser positiva)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Cantidade" ;
            sh:order 1 ;
            sh:path ms:amount ],
        [ skos:example "'ms:token', 'ms:word3', 'ms:text1'" ;
            sh:description "Unidade de medida: un IRI de ms:SizeUnitTaxonomy (p. ex., ms:token, ms:word3, ms:text1, ms:file, ms:gb)." ;
            sh:in ( ms:T-HPair ms:article ms:bigram ms:byte ms:class ms:concept ms:diphone1 ms:element ms:entry ms:expression ms:file ms:five-gram ms:four-gram ms:frame1 ms:gb ms:hour1 ms:idiomaticExpression ms:image2 ms:ingestedRecord ms:internalRecord ms:item ms:kb ms:keyword1 ms:lexicalType ms:mb ms:minute ms:multiWordUnit ms:neologism ms:other ms:parameter ms:phoneme2 ms:phoneticUnit ms:phrase1 ms:predicate ms:publishedRecord ms:question ms:rule ms:second ms:segment ms:semanticUnit1 ms:sentence1 ms:shot1 ms:syllable2 ms:synset ms:syntacticUnit1 ms:tb ms:term ms:text1 ms:token ms:translationUnit ms:trigram ms:triple ms:turn ms:unigram ms:unit ms:unspecified ms:utterance1 ms:word3 ms:tokens ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Unidade de tamaño" ;
            sh:order 2 ;
            sh:path ms:sizeUnit ] ;
    sh:targetClass ms:Size .

gax-validation:LexicalConceptualResourceIdentificationGroup a sh:PropertyGroup ;
    rdfs:label "Identificación" ;
    sh:order 2 .

gax-validation:OrganizationShape a sh:NodeShape ;
    sh:property [ skos:example "'Fundación para la Transformación de la Rioja'" ;
            sh:datatype rdf:langString ;
            sh:description "Nome legal da organización responsable da publicación." ;
            sh:minCount 1 ;
            sh:name "Nome do editor" ;
            sh:order 1 ;
            sh:path foaf:name ],
        [ skos:example "'(un obxecto de tipo adms:Identifier con skos:notation e adms:schemaAgency)'" ;
            sh:description "Identificador(es) ADMS da organización (p. ex., ISNI, ROR)." ;
            sh:name "Identificador" ;
            sh:node gax-validation:IdentifierShape ;
            sh:order 2 ;
            sh:path adms:identifier ] ;
    sh:targetClass foaf:Organization .

gax-validation:IdentifierShape a sh:NodeShape ;
    sh:property [ skos:example "'https://doi.org/10.57771/rnyr-fa06a', 'https://isni.org/isni/0000000121748431', 'CC-BY-NC-SA-4.0'" ;
            sh:datatype xsd:string ;
            sh:description "Valor do identificador (p. ex., DOI, Handle, ISNI, ROR, SPDX). Cadea libre, como en LanguageDCAT-AP." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Notación" ;
            sh:order 1 ;
            sh:path skos:notation ],
        [ skos:example "''ISNI International Agency'@en', ''ROR'@en'" ;
            sh:datatype rdf:langString ;
            sh:description "Axencia responsable do esquema do identificador. Admite varios idiomas mediante etiquetas de idioma." ;
            sh:name "Axencia do esquema" ;
            sh:order 2 ;
            sh:path adms:schemaAgency ] ;
    sh:targetClass adms:Identifier .

gax-validation:LanguageShape a sh:NodeShape ;
    sh:property [ skos:example "'bcp47:language_es', 'bcp47:language_ca', 'bcp47:language_en', 'bcp47:language_it'" ;
            sh:description "IRI do código de idioma BCP47 do vocabulario w3id BCP47 utilizado por LanguageDCAT-AP (p. ex., bcp47:language_it = http://w3id.org/meta-share/bcp47/language_it)." ;
            sh:group gax-validation:LanguageLanguageGroup ;
            sh:in ( bcp47:language_aa bcp47:language_ab bcp47:language_ae bcp47:language_af bcp47:language_ak bcp47:language_am bcp47:language_an bcp47:language_ar bcp47:language_as bcp47:language_av bcp47:language_ay bcp47:language_az bcp47:language_ba bcp47:language_be bcp47:language_bg bcp47:language_bh bcp47:language_bi bcp47:language_bm bcp47:language_bn bcp47:language_bo bcp47:language_br bcp47:language_bs bcp47:language_ca bcp47:language_ce bcp47:language_ch bcp47:language_co bcp47:language_cr bcp47:language_cs bcp47:language_cu bcp47:language_cv bcp47:language_cy bcp47:language_da bcp47:language_de bcp47:language_dv bcp47:language_dz bcp47:language_ee bcp47:language_el bcp47:language_en bcp47:language_eo bcp47:language_es bcp47:language_et bcp47:language_eu bcp47:language_fa bcp47:language_ff bcp47:language_fi bcp47:language_fj bcp47:language_fo bcp47:language_fr bcp47:language_fy bcp47:language_ga bcp47:language_gd bcp47:language_gl bcp47:language_gn bcp47:language_gu bcp47:language_gv bcp47:language_ha bcp47:language_he bcp47:language_hi bcp47:language_ho bcp47:language_hr bcp47:language_ht bcp47:language_hu bcp47:language_hy bcp47:language_hz bcp47:language_ia bcp47:language_id bcp47:language_ie bcp47:language_ig bcp47:language_ii bcp47:language_ik bcp47:language_in bcp47:language_io bcp47:language_is bcp47:language_it bcp47:language_iu bcp47:language_iw bcp47:language_ja bcp47:language_ji bcp47:language_jv bcp47:language_jw bcp47:language_ka bcp47:language_kg bcp47:language_ki bcp47:language_kj bcp47:language_kk bcp47:language_kl bcp47:language_km bcp47:language_kn bcp47:language_ko bcp47:language_kr bcp47:language_ks bcp47:language_ku bcp47:language_kv bcp47:language_kw bcp47:language_ky bcp47:language_la bcp47:language_lb bcp47:language_lg bcp47:language_li bcp47:language_ln bcp47:language_lo bcp47:language_lt bcp47:language_lu bcp47:language_lv bcp47:language_mg bcp47:language_mh bcp47:language_mi bcp47:language_mk bcp47:language_ml bcp47:language_mn bcp47:language_mo bcp47:language_mr bcp47:language_ms bcp47:language_mt bcp47:language_my bcp47:language_na bcp47:language_nb bcp47:language_nd bcp47:language_ne bcp47:language_ng bcp47:language_nl bcp47:language_nn bcp47:language_no bcp47:language_nr bcp47:language_nv bcp47:language_ny bcp47:language_oc bcp47:language_oj bcp47:language_om bcp47:language_or bcp47:language_os bcp47:language_pa bcp47:language_pi bcp47:language_pl bcp47:language_ps bcp47:language_pt bcp47:language_qu bcp47:language_rm bcp47:language_rn bcp47:language_ro bcp47:language_ru bcp47:language_rw bcp47:language_sa bcp47:language_sc bcp47:language_sd bcp47:language_se bcp47:language_sg bcp47:language_sh bcp47:language_si bcp47:language_sk bcp47:language_sl bcp47:language_sm bcp47:language_sn bcp47:language_so bcp47:language_sq bcp47:language_sr bcp47:language_ss bcp47:language_st bcp47:language_su bcp47:language_sv bcp47:language_sw bcp47:language_ta bcp47:language_te bcp47:language_tg bcp47:language_th bcp47:language_ti bcp47:language_tk bcp47:language_tl bcp47:language_tn bcp47:language_to bcp47:language_tr bcp47:language_ts bcp47:language_tt bcp47:language_tw bcp47:language_ty bcp47:language_ug bcp47:language_uk bcp47:language_ur bcp47:language_uz bcp47:language_ve bcp47:language_vi bcp47:language_vo bcp47:language_wa bcp47:language_wo bcp47:language_xh bcp47:language_yi bcp47:language_yo bcp47:language_za bcp47:language_zh bcp47:language_zu ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Código de idioma" ;
            sh:order 1 ;
            sh:path ms:languageCode ],
        [ skos:example "'bcp47:region_ES', 'bcp47:region_MX', 'bcp47:region_AD'" ;
            sh:description "IRI do código de rexión BCP47 de ms:LocationTaxonomy (p. ex., códigos de país ISO 3166-1 alfa-2)." ;
            sh:group gax-validation:LanguageLanguageGroup ;
            sh:in ( bcp47:region_AA bcp47:region_AC bcp47:region_AD bcp47:region_AE bcp47:region_AF bcp47:region_AG bcp47:region_AI bcp47:region_AL bcp47:region_AM bcp47:region_AN bcp47:region_AO bcp47:region_AQ bcp47:region_AR bcp47:region_AS bcp47:region_AT bcp47:region_AU bcp47:region_AW bcp47:region_AX bcp47:region_AZ bcp47:region_BA bcp47:region_BB bcp47:region_BD bcp47:region_BE bcp47:region_BF bcp47:region_BG bcp47:region_BH bcp47:region_BI bcp47:region_BJ bcp47:region_BL bcp47:region_BM bcp47:region_BN bcp47:region_BO bcp47:region_BQ bcp47:region_BR bcp47:region_BS bcp47:region_BT bcp47:region_BU bcp47:region_BV bcp47:region_BW bcp47:region_BY bcp47:region_BZ bcp47:region_CA bcp47:region_CC bcp47:region_CD bcp47:region_CF bcp47:region_CG bcp47:region_CH bcp47:region_CI bcp47:region_CK bcp47:region_CL bcp47:region_CM bcp47:region_CN bcp47:region_CO bcp47:region_CP bcp47:region_CQ bcp47:region_CR bcp47:region_CS bcp47:region_CU bcp47:region_CV bcp47:region_CW bcp47:region_CX bcp47:region_CY bcp47:region_CZ bcp47:region_DD bcp47:region_DE bcp47:region_DG bcp47:region_DJ bcp47:region_DK bcp47:region_DM bcp47:region_DO bcp47:region_DZ bcp47:region_EA bcp47:region_EC bcp47:region_EE bcp47:region_EG bcp47:region_EH bcp47:region_ER bcp47:region_ES bcp47:region_ET bcp47:region_EU bcp47:region_EZ bcp47:region_FI bcp47:region_FJ bcp47:region_FK bcp47:region_FM bcp47:region_FO bcp47:region_FR bcp47:region_FX bcp47:region_GA bcp47:region_GB bcp47:region_GD bcp47:region_GE bcp47:region_GF bcp47:region_GG bcp47:region_GH bcp47:region_GI bcp47:region_GL bcp47:region_GM bcp47:region_GN bcp47:region_GP bcp47:region_GQ bcp47:region_GR bcp47:region_GS bcp47:region_GT bcp47:region_GU bcp47:region_GW bcp47:region_GY bcp47:region_HK bcp47:region_HM bcp47:region_HN bcp47:region_HR bcp47:region_HT bcp47:region_HU bcp47:region_IC bcp47:region_ID bcp47:region_IE bcp47:region_IL bcp47:region_IM bcp47:region_IN bcp47:region_IO bcp47:region_IQ bcp47:region_IR bcp47:region_IS bcp47:region_IT bcp47:region_JE bcp47:region_JM bcp47:region_JO bcp47:region_JP bcp47:region_KE bcp47:region_KG bcp47:region_KH bcp47:region_KI bcp47:region_KM bcp47:region_KN bcp47:region_KP bcp47:region_KR bcp47:region_KW bcp47:region_KY bcp47:region_KZ bcp47:region_LA bcp47:region_LB bcp47:region_LC bcp47:region_LI bcp47:region_LK bcp47:region_LR bcp47:region_LS bcp47:region_LT bcp47:region_LU bcp47:region_LV bcp47:region_LY bcp47:region_MA bcp47:region_MC bcp47:region_MD bcp47:region_ME bcp47:region_MF bcp47:region_MG bcp47:region_MH bcp47:region_MK bcp47:region_ML bcp47:region_MM bcp47:region_MN bcp47:region_MO bcp47:region_MP bcp47:region_MQ bcp47:region_MR bcp47:region_MS bcp47:region_MT bcp47:region_MU bcp47:region_MV bcp47:region_MW bcp47:region_MX bcp47:region_MY bcp47:region_MZ bcp47:region_NA bcp47:region_NC bcp47:region_NE bcp47:region_NF bcp47:region_NG bcp47:region_NI bcp47:region_NL bcp47:region_NO bcp47:region_NP bcp47:region_NR bcp47:region_NT bcp47:region_NU bcp47:region_NZ bcp47:region_OM bcp47:region_PA bcp47:region_PE bcp47:region_PF bcp47:region_PG bcp47:region_PH bcp47:region_PK bcp47:region_PL bcp47:region_PM bcp47:region_PN bcp47:region_PR bcp47:region_PS bcp47:region_PT bcp47:region_PW bcp47:region_PY bcp47:region_QA bcp47:region_RE bcp47:region_RO bcp47:region_RS bcp47:region_RU bcp47:region_RW bcp47:region_SA bcp47:region_SB bcp47:region_SC bcp47:region_SD bcp47:region_SE bcp47:region_SG bcp47:region_SH bcp47:region_SI bcp47:region_SJ bcp47:region_SK bcp47:region_SL bcp47:region_SM bcp47:region_SN bcp47:region_SO bcp47:region_SR bcp47:region_SS bcp47:region_ST bcp47:region_SU bcp47:region_SV bcp47:region_SX bcp47:region_SY bcp47:region_SZ bcp47:region_TA bcp47:region_TC bcp47:region_TD bcp47:region_TF bcp47:region_TG bcp47:region_TH bcp47:region_TJ bcp47:region_TK bcp47:region_TL bcp47:region_TM bcp47:region_TN bcp47:region_TO bcp47:region_TP bcp47:region_TR bcp47:region_TT bcp47:region_TV bcp47:region_TW bcp47:region_TZ bcp47:region_UA bcp47:region_UG bcp47:region_UM bcp47:region_UN bcp47:region_US bcp47:region_UY bcp47:region_UZ bcp47:region_VA bcp47:region_VC bcp47:region_VE bcp47:region_VG bcp47:region_VI bcp47:region_VN bcp47:region_VU bcp47:region_WF bcp47:region_WS bcp47:region_YD bcp47:region_YE bcp47:region_YT bcp47:region_YU bcp47:region_ZA bcp47:region_ZM bcp47:region_ZR bcp47:region_ZW bcp47:region_ZZ ) ;
            sh:maxCount 1 ;
            sh:name "Rexión" ;
            sh:order 2 ;
            sh:path ms:region ],
        [ skos:example "'bcp47:script_Latn'" ;
            sh:description "IRI do código de sistema de escritura BCP47 de ms:ScriptTaxonomy (p. ex., códigos de escritura ISO 15924)." ;
            sh:group gax-validation:LanguageLanguageGroup ;
            sh:in ( bcp47:script_Latn ms:Latn ) ;
            sh:maxCount 1 ;
            sh:name "Sistema de escritura" ;
            sh:order 3 ;
            sh:path ms:script ],
        [ skos:example "'bcp47:variant_valencia', 'bcp47:variant_biscayan', 'bcp47:variant_aranes'" ;
            sh:description "IRI(s) do código de variante BCP47 de ms:VariantTaxonomy." ;
            sh:group gax-validation:LanguageLanguageGroup ;
