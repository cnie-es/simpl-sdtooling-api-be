{
  "type": "object",
  "required": ["type", "region", "bucketName", "objectName"],
  "properties": {
    "type": {
      "type": "string",
      "const": "AmazonS3",
      "default": "AmazonS3"
    },
    "endpointOverride": {
      "type": "string",
      "format": "uri",
      "description": "S3 endpoint. Only for S3-compatible (MinIO/Weka). In real AWS, omit."
    },
    "region": {
      "type": "string",
      "enum": ["af-south-1","ap-east-1","ap-northeast-1","ap-northeast-2","ap-northeast-3","ap-south-1","ap-south-2","ap-southeast-1","ap-southeast-2","ap-southeast-3","ap-southeast-4","ap-southeast-5","ap-southeast-7","ca-central-1","ca-west-1","eu-central-1","eu-central-2","eu-north-1","eu-south-1","eu-south-2","eu-west-1","eu-west-2","eu-west-3","il-central-1","me-central-1","me-south-1","mx-central-1","sa-east-1","us-east-1","us-east-2","us-west-1","us-west-2"]
    },
    "bucketName": {
      "type": "string",
      "pattern": "^[a-z0-9.-]{3,63}$",
      "description": "Bucket name must be between 3 and 63 characters and lowercase"
    },
    "objectName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Object name must be between 1 and 1024 characters"
    }
  }
}