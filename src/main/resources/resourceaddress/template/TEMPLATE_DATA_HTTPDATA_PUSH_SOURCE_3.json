{
  "type": "object",
  "required": [
    "type",
    "name",
    "baseUrl",
    "proxyPath"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "HttpData",
      "default": "HttpData"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "A human-readable name for the asset"
    },
    "baseUrl": {
      "type": "string",
      "format": "uri",
      "description": "The base URL from which the HTTP data is pulled"
    },
    "proxyPath": {
      "type": "string",
      "enum": ["true", "false"],
      "description": "Whether to enable proxying the path"
    }
  }
}