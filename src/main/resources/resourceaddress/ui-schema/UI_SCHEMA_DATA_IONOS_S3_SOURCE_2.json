{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Control",
      "scope": "#/properties/type",
      "label": "Source type",
      "options": {
        "readonly": true
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/region",
      "label": "Region"
    },
    {
      "type": "Control",
      "scope": "#/properties/storage",
      "label": "Storage URL"
    },
    {
      "type": "Control",
      "scope": "#/properties/bucketName",
      "label": "Bucket name"
    },
    {
      "type": "Control",
      "scope": "#/properties/blobName",
      "label": "File name"
    },
    {
      "type": "Control",
      "scope": "#/properties/accessKey",
      "label": "Access Key",
      "options": {
        "hideToggle": true
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/secretKey",
      "label": "Secret Key",
      "options": {
        "hideToggle": true,
        "format": "password"
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/keyName",
      "label": "Key name"
    }
  ]
}

